            "code": "add_filter('rank_math/json_ld', function($data, $jsonld){\r\n    if(!is_page()) return $data;\r\n    $id = get_queried_object_id();\r\n    $names = array(\r\n        894 => 'Tomografía Cardiaca y Angio-TAC',\r\n        892 => 'Resonancia Magnética Cardiovascular (CMR)',\r\n        890 => 'Sistema HIS Medsi',\r\n        883 => 'PACS-RIS',\r\n        874 => 'Teleradiología de Alta Especialidad',\r\n        881 => 'Portal X-Card',\r\n        879 => 'Monitores Médicos para Radiología',\r\n        871 => 'Servicio de Teleradiología 24/7',\r\n        862 => 'PACS Teleradiología (VIRA)',\r\n    );\r\n    if(!isset($names[$id])) return $data;\r\n    foreach($data as $k => $node){\r\n        if(isset($node['@type']) && $node['@type'] === 'BreadcrumbList'){\r\n            $data[$k]['itemListElement'] = array(\r\n                array('@type'=>'ListItem','position'=>1,'name'=>'Inicio','item'=>'https://raditech.mx/'),\r\n                array('@type'=>'ListItem','position'=>2,'name'=>'Productos','item'=>'https://raditech.mx/nuestros-productos/'),\r\n                array('@type'=>'ListItem','position'=>3,'name'=>$names[$id],'item'=>get_permalink($id)),\r\n            );\r\n        }\r\n    }\r\n    return $data;\r\n}, 99, 2);",
