ent: \"→\";\r\n      color: var(--rt-orange);\r\n      font-weight: 950;\r\n      opacity: 0.85;\r\n      transition: transform 0.22s ease;\r\n    }\r\n\r\n    .rt-footer-links a:hover {\r\n      color: var(--rt-orange-2);\r\n      transform: translateX(3px);\r\n    }\r\n\r\n    .rt-footer-links a:hover::before {\r\n      transform: translateX(2px);\r\n    }\r\n\r\n    .rt-footer-contact-card {\r\n      padding: 22px;\r\n      border-radius: 26px;\r\n      background: linear-gradient(180deg, rgba(19, 44, 72, 0.92) 0%, rgba(13, 33, 56, 0.92) 100%);\r\n      border: 1px solid rgba(255, 255, 255, 0.09);\r\n      box-shadow: var(--rt-shadow);\r\n    }\r\n\r\n    .rt-footer-contact-card h3 {\r\n      margin-bottom: 14px;\r\n    }\r\n\r\n    .rt-footer-contact-card p {\r\n      margin: 0 0 18px;\r\n      color: var(--rt-muted);\r\n      line-height: 1.65;\r\n      font-size: 15.5px;\r\n    }\r\n\r\n    .rt-footer-cta {\r\n      position: relative;\r\n      display: inline-flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      width: 100%;\r\n      min-height: 50px;\r\n      padding: 14px 18px;\r\n      border-radius: 999px;\r\n      color: #071423;\r\n      background: linear-gradient(135deg, var(--rt-orange), var(--rt-orange-2));\r\n      font-size: 15px;\r\n      font-weight: 950;\r\n      text-align: center;\r\n      text-decoration: none;\r\n      box-shadow: 0 16px 38px rgba(240, 154, 55, 0.24);\r\n      overflow: hidden;\r\n      transition: transform 0.22s ease, box-shadow 0.22s ease;\r\n    }\r\n\r\n    .rt-footer-cta::after {\r\n      content: \"\";\r\n      position: absolute;\r\n      inset: 0;\r\n      background: linear-gradient(100deg, transparent 0%, rgba(255,255,255,.32) 45%, transparent 70%);\r\n      transform: translateX(-120%);\r\n      transition: transform .7s ease;\r\n      pointer-events: none;\r\n    }\r\n\r\n    .rt-footer-cta:hover {\r\n      transform: translateY(-2px);\r\n      box-shadow: 0 20px 48px rgba(240, 154, 55,