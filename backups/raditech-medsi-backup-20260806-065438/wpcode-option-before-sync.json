            "id": 867,
            "title": "Title: Header Raditech",
            "code": "<header class=\"rt-site-header\" id=\"rt-site-header\">\r\n  <style>\r\n    .rt-site-header,\r\n    .rt-site-header * {\r\n      box-sizing: border-box;\r\n    }\r\n\r\n    .rt-site-header {\r\n      --rt-bg: #061423;\r\n      --rt-bg-2: #0a1d31;\r\n      --rt-card: #0d2138;\r\n      --rt-white: #ffffff;\r\n      --rt-text: #eaf1f8;\r\n      --rt-muted: #b8c6d8;\r\n      --rt-orange: #f09a37;\r\n      --rt-orange-2: #ffb65c;\r\n      --rt-line: rgba(255, 255, 255, 0.1);\r\n      --rt-shadow: 0 18px 55px rgba(0, 0, 0, 0.28);\r\n\r\n      position: sticky;\r\n      top: 0;\r\n      left: 0;\r\n      right: 0;\r\n      z-index: 99999;\r\n      width: 100%;\r\n      font-family: inherit;\r\n      color: var(--rt-text);\r\n      background: rgba(6, 20, 35, 0.92);\r\n      border-bottom: 1px solid rgba(255, 255, 255, 0.08);\r\n      backdrop-filter: blur(18px);\r\n      -webkit-backdrop-filter: blur(18px);\r\n    }\r\n\r\n    .rt-site-header::before {\r\n      content: \"\";\r\n      position: absolute;\r\n      inset: 0;\r\n      z-index: -1;\r\n      pointer-events: none;\r\n      background:\r\n        radial-gradient(circle at 12% 0%, rgba(240, 154, 55, 0.11), transparent 30%),\r\n        linear-gradient(135deg, rgba(4, 17, 29, 0.96), rgba(9, 28, 47, 0.92));\r\n    }\r\n\r\n    .rt-header-wrap {\r\n      width: min(1180px, calc(100% - 32px));\r\n      min-height: 88px;\r\n      margin: 0 auto;\r\n      display: grid;\r\n      grid-template-columns: auto 1fr auto;\r\n      gap: 28px;\r\n      align-items: center;\r\n    }\r\n\r\n    .rt-header-logo {\r\n      display: inline-flex;\r\n      align-items: center;\r\n      justify-content: flex-start;\r\n      width: 230px;\r\n      max-width: 230px;\r\n      padding: 8px 0;\r\n      text-decoration: none;\r\n    }\r\n\r\n    .rt-header-logo img {\r\n      display: block;\r\n      width: 100%;\r\n      height: auto;\r\n      object-fit: contain;\r\n    }\r\n\r\n    .rt-header-nav {\r\n      display: flex;\r\n      justify-content: flex-end;\r\n      align-items: center;\r\n      min-width: 0;\r\n    }\r\n\r\n    .rt-header-menu {\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: flex-end;\r\n      gap: 5px;\r\n      margin: 0;\r\n      padding: 0;\r\n      list-style: none;\r\n    }\r\n\r\n    .rt-header-menu li {\r\n      position: relative;\r\n      margin: 0;\r\n      padding: 0;\r\n      list-style: none;\r\n    }\r\n\r\n    .rt-header-menu a,\r\n    .rt-header-menu button {\r\n      display: inline-flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      gap: 7px;\r\n      min-height: 44px;\r\n      padding: 12px 13px;\r\n      border: 0;\r\n      border-radius: 999px;\r\n      background: transparent;\r\n      color: var(--rt-muted);\r\n      font-family: inherit;\r\n      font-size: 15px;\r\n      font-weight: 900;\r\n      line-height: 1;\r\n      text-decoration: none;\r\n      cursor: pointer;\r\n      transition: color 0.22s ease, background 0.22s ease, transform 0.22s ease;\r\n      white-space: nowrap;\r\n    }\r\n\r\n    .rt-header-menu a:hover,\r\n    .rt-header-menu button:hover {\r\n      color: var(--rt-orange-2);\r\n      background: rgba(240, 154, 55, 0.1);\r\n    }\r\n\r\n    .rt-header-menu button::after {\r\n      content: \"⌄\";\r\n      display: inline-block;\r\n      font-size: 15px;\r\n      line-height: 1;\r\n      transform: translateY(-1px);\r\n      opacity: 0.9;\r\n    }\r\n\r\n    .rt-header-dropdown {\r\n      position: absolute;\r\n      top: calc(100% + 12px);\r\n      left: 0;\r\n      min-width: 320px;\r\n      padding: 10px;\r\n      border-radius: 24px;\r\n      background: linear-gradient(180deg, #132c48 0%, #0d2138 100%);\r\n      border: 1px solid rgba(255, 255, 255, 0.1);\r\n      box-shadow: var(--rt-shadow);\r\n      opacity: 0;\r\n      visibility: hidden;\r\n      transform: translateY(8px);\r\n      transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s ease;\r\n    }\r\n\r\n    .rt-header-dropdown::before {\r\n      content: \"\";\r\n      position: absolute;\r\n      left: 28px;\r\n      top: -7px;\r\n      width: 14px;\r\n      height: 14px;\r\n      background: #132c48;\r\n      border-left: 1px solid rgba(255, 255, 255, 0.1);\r\n      border-top: 1px solid rgba(255, 255, 255, 0.1);\r\n      transform: rotate(45deg);\r\n    }\r\n\r\n    .rt-header-menu li:hover > .rt-header-dropdown,\r\n    .rt-header-menu li:focus-within > .rt-header-dropdown {\r\n      opacity: 1;\r\n      visibility: visible;\r\n      transform: translateY(0);\r\n    }\r\n\r\n    .rt-header-dropdown a {\r\n      width: 100%;\r\n      min-height: auto;\r\n      justify-content: flex-start;\r\n      padding: 14px 15px;\r\n      border-radius: 16px;\r\n      color: #eaf1f8;\r\n      line-height: 1.25;\r\n      white-space: normal;\r\n    }\r\n\r\n    .rt-header-dropdown a:hover {\r\n      color: #071423;\r\n      background: linear-gradient(135deg, var(--rt-orange), var(--rt-orange-2));\r\n    }\r\n\r\n    .rt-header-actions {\r\n      display: flex;\r\n      align-items: center;\r\n      gap: 10px;\r\n    }\r\n\r\n    .rt-header-cta {\r\n      position: relative;\r\n      display: inline-flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      min-height: 46px;\r\n      padding: 13px 18px;\r\n      border-radius: 999px;\r\n      color: #071423;\r\n      background: linear-gradient(135deg, var(--rt-orange), var(--rt-orange-2));\r\n      font-size: 15px;\r\n      font-weight: 950;\r\n      text-decoration: none;\r\n      box-shadow: 0 16px 38px rgba(240, 154, 55, 0.24);\r\n      overflow: hidden;\r\n      transition: transform 0.22s ease, box-shadow 0.22s ease;\r\n      white-space: nowrap;\r\n    }\r\n\r\n    .rt-header-cta::after {\r\n      content: \"\";\r\n      position: absolute;\r\n      inset: 0;\r\n      background: linear-gradient(100deg, transparent 0%, rgba(255,255,255,.32) 45%, transparent 70%);\r\n      transform: translateX(-120%);\r\n      transition: transform .7s ease;\r\n      pointer-events: none;\r\n    }\r\n\r\n    .rt-header-cta:hover {\r\n      transform: translateY(-2px);\r\n      box-shadow: 0 20px 48px rgba(240, 154, 55, 0.34);\r\n    }\r\n\r\n    .rt-header-cta:hover::after {\r\n      transform: translateX(120%);\r\n    }\r\n\r\n    .rt-mobile-toggle {\r\n      display: none;\r\n      width: 48px;\r\n      height: 48px;\r\n      border: 1px solid rgba(255, 255, 255, 0.13);\r\n      border-radius: 16px;\r\n      background: rgba(255, 255, 255, 0.055);\r\n      color: var(--rt-white);\r\n      cursor: pointer;\r\n      align-items: center;\r\n      justify-content: center;\r\n      padding: 0;\r\n    }\r\n\r\n    .rt-mobile-toggle span {\r\n      position: relative;\r\n      width: 22px;\r\n      height: 2px;\r\n      border-radius: 999px;\r\n      background: var(--rt-white);\r\n      display: block;\r\n      transition: background 0.22s ease;\r\n    }\r\n\r\n    .rt-mobile-toggle span::before,\r\n    .rt-mobile-toggle span::after {\r\n      content: \"\";\r\n      position: absolute;\r\n      left: 0;\r\n      width: 22px;\r\n      height: 2px;\r\n      border-radius: 999px;\r\n      background: var(--rt-white);\r\n      transition: transform 0.22s ease, top 0.22s ease;\r\n    }\r\n\r\n    .rt-mobile-toggle span::before {\r\n      top: -7px;\r\n    }\r\n\r\n    .rt-mobile-toggle span::after {\r\n      top: 7px;\r\n    }\r\n\r\n    .rt-site-header.rt-open .rt-mobile-toggle span {\r\n      background: transparent;\r\n    }\r\n\r\n    .rt-site-header.rt-open .rt-mobile-toggle span::before {\r\n      top: 0;\r\n      transform: rotate(45deg);\r\n    }\r\n\r\n    .rt-site-header.rt-open .rt-mobile-toggle span::after {\r\n      top: 0;\r\n      transform: rotate(-45deg);\r\n    }\r\n\r\n    @media (max-width: 1120px) {\r\n      .rt-header-wrap {\r\n        grid-template-columns: auto auto;\r\n        justify-content: space-between;\r\n        min-height: 82px;\r\n      }\r\n\r\n      .rt-header-logo {\r\n        width: 214px;\r\n      }\r\n\r\n      .rt-mobile-toggle {\r\n        display: inline-flex;\r\n      }\r\n\r\n      .rt-header-actions {\r\n        display: none;\r\n      }\r\n\r\n      .rt-header-nav {\r\n        position: absolute;\r\n        left: 16px;\r\n        right: 16px;\r\n        top: calc(100% + 10px);\r\n        display: block;\r\n        max-height: calc(100vh - 110px);\r\n        overflow-y: auto;\r\n        padding: 14px;\r\n        border-radius: 26px;\r\n        background: linear-gradient(180deg, rgba(19, 44, 72, 0.98) 0%, rgba(13, 33, 56, 0.98) 100%);\r\n        border: 1px solid rgba(255, 255, 255, 0.1);\r\n        box-shadow: var(--rt-shadow);\r\n        opacity: 0;\r\n        visibility: hidden;\r\n        transform: translateY(8px);\r\n        transition: opacity 0.22s ease, visibility 0.22s ease, transform 0.22s ease;\r\n      }\r\n\r\n      .rt-site-header.rt-open .rt-header-nav {\r\n        opacity: 1;\r\n        visibility: visible;\r\n        transform: translateY(0);\r\n      }\r\n\r\n      .rt-header-menu {\r\n        display: grid;\r\n        gap: 8px;\r\n        justify-content: stretch;\r\n      }\r\n\r\n      .rt-header-menu a,\r\n      .rt-header-menu button {\r\n        width: 100%;\r\n        justify-content: space-between;\r\n        min-height: 50px;\r\n        padding: 15px 16px;\r\n        border-radius: 18px;\r\n        background: rgba(255, 255, 255, 0.045);\r\n        color: #ffffff;\r\n      }\r\n\r\n      .rt-header-menu button::after {\r\n        content: \"+\";\r\n        font-size: 20px;\r\n      }\r\n\r\n      .rt-header-menu li.rt-submenu-open > button::after {\r\n        content: \"−\";\r\n      }\r\n\r\n      .rt-header-dropdown {\r\n        position: static;\r\n        min-width: 0;\r\n        width: 100%;\r\n        margin-top: 8px;\r\n        padding: 8px;\r\n        border-radius: 20px;\r\n        box-shadow: none;\r\n        opacity: 1;\r\n        visibility: visible;\r\n        transform: none;\r\n        display: none;\r\n        background: rgba(0, 0, 0, 0.16);\r\n      }\r\n\r\n      .rt-header-dropdown::before {\r\n        display: none;\r\n      }\r\n\r\n      .rt-header-menu li.rt-submenu-open > .rt-header-dropdown {\r\n        display: grid;\r\n        gap: 6px;\r\n      }\r\n\r\n      .rt-header-dropdown a {\r\n        border-radius: 15px;\r\n        background: rgba(255, 255, 255, 0.045);\r\n      }\r\n\r\n      .rt-mobile-cta {\r\n        display: inline-flex !important;\r\n        margin-top: 8px;\r\n        color: #071423 !important;\r\n        background: linear-gradient(135deg, var(--rt-orange), var(--rt-orange-2)) !important;\r\n      }\r\n    }\r\n\r\n    @media (min-width: 1121px) {\r\n      .rt-mobile-cta {\r\n        display: none !important;\r\n      }\r\n    }\r\n\r\n    @media (max-width: 620px) {\r\n      .rt-header-wrap {\r\n        width: min(100% - 22px, 1180px);\r\n        min-height: 76px;\r\n      }\r\n\r\n      .rt-header-logo {\r\n        width: 188px;\r\n      }\r\n\r\n      .rt-header-nav {\r\n        left: 11px;\r\n        right: 11px;\r\n        border-radius: 22px;\r\n      }\r\n    }\r\n\r\n    @media (max-width: 420px) {\r\n      .rt-header-logo {\r\n        width: 165px;\r\n      }\r\n\r\n      .rt-mobile-toggle {\r\n        width: 44px;\r\n        height: 44px;\r\n      }\r\n    }\r\n  </style>\r\n\r\n  <div class=\"rt-header-wrap\">\r\n    <a class=\"rt-header-logo\" href=\"https://raditech.mx/\" aria-label=\"Raditech inicio\">\r\n      <img src=\"https://raditech.mx/wp-content/uploads/2024/11/logo-raditech-blanco-300x75-1.png\" alt=\"Raditech\">\r\n    </a>\r\n\r\n    <nav class=\"rt-header-nav\" aria-label=\"Menú principal Raditech\">\r\n      <ul class=\"rt-header-menu\">\r\n        <li>\r\n          <a href=\"https://raditech.mx/\">Inicio</a>\r\n        </li>\r\n\r\n        <li>\r\n          <button type=\"button\" class=\"rt-submenu-toggle\" aria-expanded=\"false\">P