 (!header) return;\r\n\r\n      const mobileToggle = header.querySelector(\".rt-mobile-toggle\");\r\n      const submenuButtons = header.querySelectorAll(\".rt-submenu-toggle\");\r\n\r\n      mobileToggle.addEventListener(\"click\", function () {\r\n        const isOpen = header.classList.toggle(\"rt-open\");\r\n        mobileToggle.setAttribute(\"aria-expanded\", isOpen ? \"true\" : \"false\");\r\n      });\r\n\r\n      submenuButtons.forEach(function (button) {\r\n        button.addEventListener(\"click\", function (event) {\r\n          if (window.innerWidth > 1120) return;\r\n\r\n          event.preventDefault();\r\n\r\n          const item = button.closest(\"li\");\r\n          const isOpen = item.classList.toggle(\"rt-submenu-open\");\r\n\r\n          button.setAttribute(\"aria-expanded\", isOpen ? \"true\" : \"false\");\r\n        });\r\n      });\r\n\r\n      document.addEventListener(\"click\", function (event) {\r\n        if (!header.contains(event.target)) {\r\n          header.classList.remove(\"rt-open\");\r\n          mobileToggle.setAttribute(\"aria-expanded\", \"false\");\r\n\r\n          header.querySelectorAll(\".rt-submenu-open\").forEach(function (item) {\r\n            item.classList.remove(\"rt-submenu-open\");\r\n          });\r\n\r\n          submenuButtons.forEach(function (button) {\r\n            button.setAttribute(\"aria-expanded\", \"false\");\r\n          });\r\n        }\r\n      });\r\n\r\n      window.addEventListener(\"resize\", function () {\r\n        if (window.innerWidth > 1120) {\r\n          header.classList.remove(\"rt-open\");\r\n          mobileToggle.setAttribute(\"aria-expanded\", \"false\");\r\n\r\n          header.querySelectorAll(\".rt-submenu-open\").forEach(function (item) {\r\n            item.classList.remove(\"rt-submenu-open\");\r\n          });\r\n\r\n          submenuButtons.forEach(function (button) {\r\n            button.setAttribute(\"aria-expanded\", \"false\");\r\n          });\r\n        }\r\n      });\r\n    })();\r\n  </script>\r\n</header>\r\n",
