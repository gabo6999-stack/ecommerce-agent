            "title": "Raditech SEO — Cache-Control + Lazy-load (2026-07-06)",
            "code": "// Raditech SEO fixes (2026-07-06): front-end Cache-Control + native lazy-load.\r\n\r\n// 1) Public Cache-Control on front-end HTML only (LiteSpeed caches & replays it).\r\nadd_action('send_headers', function () {\r\n    if (is_admin() || is_user_logged_in()) { return; }\r\n    if (is_feed() || is_robots() || is_trackback()) { return; }\r\n    header('Cache-Control: public, max-age=600');\r\n}, 99);\r\n\r\n// 2) Add loading=lazy to images past the first 5 (keeps header logo + hero eager for LCP).\r\nadd_action('template_redirect', function () {\r\n    if (is_admin() || is_feed() || is_robots() || is_trackback()) { return; }\r\n    if (defined('REST_REQUEST') && REST_REQUEST) { return; }\r\n    if (isset($_GET['elementor-preview']) || isset($_GET['preview'])) { return; }\r\n    if (!isset($_SERVER['REQUEST_METHOD']) || $_SERVER['REQUEST_METHOD'] !== 'GET') { return; }\r\n    ob_start(function ($html) {\r\n        if (!$html || stripos($html, '<img') === false) { return $html; }\r\n        $i = 0;\r\n        return preg_replace_callback('/<img\\\\b[^>]*>/i', function ($m) use (&$i) {\r\n            $tag = $m[0];\r\n            $i++;\r\n            if ($i <= 5) { return $tag; }\r\n            if (preg_match('/\\\\bloading\\\\s*=/i', $tag)) { return $tag; }\r\n            return preg_replace('/<img\\\\b/i', '<img loading=\"lazy\" decoding=\"async\"', $tag, 1);\r\n        }, $html);\r\n    });\r\n}, 0);\r\n",
