r\n    </div>\r\n  </section>\r\n\r\n</section>\r\n\r\n<style>\r\n  .pys-longevity-page {\r\n    position: relative;\r\n    overflow: hidden;\r\n    color: #F5F5F2;\r\n    font-family: \"Inter\", \"Helvetica Neue\", Arial, sans-serif;\r\n    background:\r\n      radial-gradient(circle at 8% 6%, rgba(0, 229, 196, .16), transparent 30%),\r\n      radial-gradient(circle at 92% 10%, rgba(247, 0, 122, .14), transparent 34%),\r\n      radial-gradient(circle at 50% 82%, rgba(0, 229, 196, .07), transparent 36%),\r\n      linear-gradient(135deg, #111111 0%, #151515 50%, #1D1118 100%);\r\n  }\r\n\r\n  .pys-longevity-page * {\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  .pys-longevity-bg {\r\n    position: absolute;\r\n    inset: 0;\r\n    pointer-events: none;\r\n    background:\r\n      radial-gradient(circle at 10% 12%, rgba(0, 229, 196, .14), transparent 28%),\r\n      radial-gradient(circle at 88% 18%, rgba(247, 0, 122, .13), transparent 30%),\r\n      radial-gradient(circle at 50% 46%, rgba(255, 255, 255, .035), transparent 38%);\r\n  }\r\n\r\n  .pys-longevity-bg::after {\r\n    content: \"\";\r\n    position: absolute;\r\n    inset: 0;\r\n    opacity: .22;\r\n    background-image:\r\n      linear-gradient(rgba(255, 255, 255, .045) 1px, transparent 1px),\r\n      linear-gradient(90deg, rgba(255, 255, 255, .045) 1px, transparent 1px);\r\n    background-size: 54px 54px;\r\n    mask-image: radial-gradient(circle at 50% 10%, black 0%, transparent 78%);\r\n  }\r\n\r\n  .pys-longevity-container {\r\n    position: relative;\r\n    z-index: 2;\r\n    width: min(100% - 32px, 1180px);\r\n    margin: 0 auto;\r\n    padding: 0;\r\n  }\r\n\r\n  .pys-longevity-hero {\r\n    position: relative;\r\n    padding: clamp(76px, 8vw, 118px) 0 clamp(58px, 6vw, 78px);\r\n  }\r\n\r\n  .pys-longevity-hero-grid {\r\n    display: grid;\r\n    grid-template-columns: 1.04fr .96fr;\r\n    gap: clamp(32px, 4vw, 56px);\r\n    align-items: center;\r\n  }\r\n\r\n  .pys-longevity-kicker {\r\n    display: