"[{\"id\":\"197c6ba4\",\"elType\":\"container\",\"settings\":[],\"elements\":[{\"id\":\"660654ad\",\"elType\":\"widget\",\"settings\":{\"editor\":\"```html\\n<section class=\\\"rm-page\\\">\\n  <style>\\n    .rm-page,\\n    .rm-page * {\\n      box-sizing: border-box;\\n    }\\n\\n    .rm-page {\\n      --rm-bg: #061423;\\n      --rm-bg-2: #0a1d31;\\n      --rm-bg-3: #102844;\\n      --rm-card: #0d2138;\\n      --rm-card-2: #132c48;\\n      --rm-white: #ffffff;\\n      --rm-text: #eaf1f8;\\n      --rm-muted: #b8c6d8;\\n      --rm-line: rgba(255, 255, 255, 0.1);\\n      --rm-orange: #f09a37;\\n      --rm-orange-2: #ffb65c;\\n      --rm-blue: #2f8cff;\\n      --rm-cyan: #19d3d3;\\n      --rm-green: #25d366;\\n      --rm-shadow: 0 28px 80px rgba(0, 0, 0, 0.34);\\n      --rm-glow: 0 0 46px rgba(240, 154, 55, 0.18);\\n      width: 100%;\\n      max-width: 100%;\\n      font-family: inherit;\\n      color: var(--rm-text);\\n      background: var(--rm-bg);\\n      overflow-x: hidden;\\n      position: relative;\\n    }\\n\\n    .rm-page a {\\n      color: inherit;\\n      text-decoration: none;\\n    }\\n\\n    .rm-page button {\\n      font-family: inherit;\\n    }\\n\\n    .rm-wrap {\\n      width: min(1180px, calc(100% - 32px));\\n      margin: 0 auto;\\n    }\\n\\n    .rm-section {\\n      padding: 82px 0;\\n      position: relative;\\n    }\\n\\n    .rm-eyebrow {\\n      display: inline-flex;\\n      align-items: center;\\n      gap: 10px;\\n      max-width: 100%;\\n      padding: 8px 14px;\\n      border-radius: 999px;\\n      border: 1px solid rgba(240, 154, 55, 0.28);\\n      background: rgba(240, 154, 55, 0.12);\\n      color: var(--rm-orange-2);\\n      font-size: 13px;\\n      font-weight: 900;\\n      line-height: 1.25;\\n      letter-spacing: 0.05em;\\n      text-transform: uppercase;\\n    }\\n\\n    .rm-eyebrow::before {\\n      content: \\\"\\\";\\n      width: 8px;\\n      height: 8px;\\n      border-radius: 50%;\\n      background: var(--rm-orange);\\n      box-shadow: 0 0 18px rgba(240, 154, 55, 0.9);\\n      flex: 0 0 auto;\\n    }\\n\\n    .rm-btn {\\n      position: relative;\\n      display: inline-flex;\\n      align-items: center;\\n      justify-content: center;\\n      gap: 10px;\\n      min-height: 54px;\\n      padding: 15px 24px;\\n      border-radius: 999px;\\n      font-weight: 900;\\n      overflow: hidden;\\n      text-align: center;\\n      transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease, border-color 0.25s ease;\\n      border: 0;\\n    }\\n\\n    .rm-btn::after {\\n      content: \\\"\\\";\\n      position: absolute;\\n      inset: 0;\\n      background: linear-gradient(100deg, transparent 0%, rgba(255, 255, 255, 0.28) 45%, transparent 70%);\\n      transform: translateX(-120%);\\n      transition: transform 0.7s ease;\\n      pointer-events: none;\\n    }\\n\\n    .rm-btn:hover::after {\\n      transform: translateX(120%);\\n    }\\n\\n    .rm-btn:hover {\\n      transform: translateY(-3px);\\n    }\\n\\n    .rm-btn-primary {\\n      color: #071423;\\n      background: linear-gradient(135deg, var(--rm-orange), var(--rm-orange-2));\\n      box-shadow: 0 16px 42px rgba(240, 154, 55, 0.26);\\n    }\\n\\n    .rm-btn-whatsapp {\\n      color: #061423;\\n      background: linear-gradient(135deg, #25d366, #8effbb);\\n      box-shadow: 0 16px 42px rgba(37, 211, 102, 0.22);\\n    }\\n\\n    .rm-btn-secondary {\\n      color: var(--rm-white);\\n      border: 1px solid rgba(255, 255, 255, 0.16);\\n      background: rgba(255, 255, 255, 0.06);\\n      backdrop-filter: blur(14px);\\n    }\\n\\n    .rm-actions {\\n      display: flex;\\n      flex-wrap: wrap;\\n      gap: 14px;\\n      margin-top: 30px;\\n    }\\n\\n    .rm-hero {\\n      position: relative;\\n      min-height: 760px;\\n      padding: 74px 0 96px;\\n      background:\\n        radial-gradient(circle at 84% 16%, rgba(240, 154, 55, 0.17), transparent 26%),\\n        radial-gradient(circle at 20% 24%, rgba(47, 140, 255, 0.12), transparent 30%),\\n        linear-gradient(135deg, #04111d 0%, #07192b 56%, #091c2f 100%);\\n      color: var(--rm-white);\\n      isolation: isolate;\\n      overflow: hidden;\\n    }\\n\\n    .rm-hero::before {\\n      content: \\\"\\\";\\n      position: absolute;\\n      inset: 0;\\n      background:\\n        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),\\n        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);\\n      background-size: 42px 42px;\\n      mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.78), transparent);\\n      z-index: -2;\\n    }\\n\\n    .rm-hero::after {\\n      content: \\\"\\\";\\n      position: absolute;\\n      inset: auto -10% -26% -10%;\\n      height: 360px;\\n      background: radial-gradient(ellipse at center, rgba(240, 154, 55, 0.13), transparent 64%);\\n      z-index: -1;\\n      pointer-events: none;\\n    }\\n\\n    .rm-hero-grid {\\n      display: grid;\\n      grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);\\n      gap: clamp(32px, 4vw, 56px);\\n      align-items: center;\\n    }\\n\\n    .rm-brand {\\n      width: 218px;\\n      max-width: 72%;\\n      margin-bottom: 28px;\\n      padding: 14px 18px;\\n      border-radius: 22px;\\n      background: rgba(255, 255, 255, 0.04);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      backdrop-filter: blur(12px);\\n      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.24);\\n    }\\n\\n    .rm-brand img {\\n      display: block;\\n      width: 100%;\\n      height: auto;\\n    }\\n\\n    .rm-hero h1 {\\n      margin: 20px 0 18px;\\n      max-width: 760px;\\n      font-size: clamp(42px, 6vw, 76px);\\n      line-height: 0.96;\\n      letter-spacing: -0.06em;\\n      font-weight: 950;\\n      color: var(--rm-white);\\n    }\\n\\n    .rm-hero h1 span {\\n      display: block;\\n      background: linear-gradient(90deg, var(--rm-orange), var(--rm-orange-2), #ffffff);\\n      -webkit-background-clip: text;\\n      background-clip: text;\\n      color: transparent;\\n    }\\n\\n    .rm-hero p {\\n      margin: 0;\\n      max-width: 700px;\\n      color: rgba(255, 255, 255, 0.82);\\n      font-size: clamp(18px, 2vw, 22px);\\n      line-height: 1.58;\\n    }\\n\\n    .rm-hero-card {\\n      position: relative;\\n      padding: 26px;\\n      border-radius: 36px;\\n      background: linear-gradient(180deg, rgba(19, 44, 72, 0.95), rgba(13, 33, 56, 0.95));\\n      border: 1px solid rgba(255, 255, 255, 0.1);\\n      box-shadow: var(--rm-shadow), var(--rm-glow);\\n      overflow: hidden;\\n      animation: rmFloat 6s ease-in-out infinite;\\n    }\\n\\n    .rm-hero-card::before {\\n      content: \\\"\\\";\\n      position: absolute;\\n      inset: -1px;\\n      background:\\n        radial-gradient(circle at 20% 18%, rgba(240, 154, 55, 0.16), transparent 32%),\\n        radial-gradient(circle at 82% 72%, rgba(25, 211, 211, 0.11), transparent 34%);\\n      pointer-events: none;\\n    }\\n\\n    .rm-monitor-visual {\\n      position: relative;\\n      z-index: 1;\\n      padding: 24px;\\n      border-radius: 30px;\\n      background: #081522;\\n      border: 1px solid rgba(255, 255, 255, 0.09);\\n      overflow: hidden;\\n    }\\n\\n    .rm-monitor-screen {\\n      position: relative;\\n      min-height: 330px;\\n      border-radius: 24px;\\n      background:\\n        radial-gradient(circle at 36% 42%, rgba(255, 255, 255, 0.15), transparent 18%),\\n        radial-gradient(circle at 60% 48%, rgba(255, 255, 255, 0.1), transparent 15%),\\n        linear-gradient(135deg, #0d1c2f, #122f50 54%, #06111e);\\n      border: 10px solid #111c2a;\\n      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06), 0 28px 70px rgba(0, 0, 0, 0.34);\\n      overflow: hidden;\\n    }\\n\\n    .rm-monitor-screen::before {\\n      content: \\\"\\\";\\n      position: absolute;\\n      inset: 0;\\n      background:\\n        linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px),\\n        linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);\\n      background-size: 28px 28px;\\n      opacity: 0.46;\\n    }\\n\\n    .rm-dicom-lines {\\n      position: absolute;\\n      inset: 24px;\\n      border-radius: 18px;\\n      border: 1px solid rgba(25, 211, 211, 0.25);\\n    }\\n\\n    .rm-dicom-lines::before,\\n    .rm-dicom-lines::after {\\n      content: \\\"\\\";\\n      position: absolute;\\n      border-radius: 999px;\\n      border: 2px solid rgba(255, 255, 255, 0.18);\\n    }\\n\\n    .rm-dicom-lines::before {\\n      width: 120px;\\n      height: 120px;\\n      left: 34px;\\n      top: 58px;\\n      box-shadow: 0 0 0 14px rgba(255, 255, 255, 0.035);\\n    }\\n\\n    .rm-dicom-lines::after {\\n      width: 150px;\\n      height: 92px;\\n      right: 40px;\\n      top: 88px;\\n      transform: rotate(-10deg);\\n      box-shadow: 0 0 0 12px rgba(255, 255, 255, 0.028);\\n    }\\n\\n    .rm-monitor-base {\\n      width: 42%;\\n      height: 16px;\\n      margin: 20px auto 0;\\n      border-radius: 999px;\\n      background: linear-gradient(90deg, #0b1725, #263a52, #0b1725);\\n      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.25);\\n    }\\n\\n    .rm-monitor-stem {\\n      width: 18%;\\n      height: 48px;\\n      margin: 0 auto;\\n      background: linear-gradient(180deg, #263a52, #0b1725);\\n      border-radius: 0 0 10px 10px;\\n    }\\n\\n    .rm-badge {\\n      position: absolute;\\n      z-index: 3;\\n      left: -18px;\\n      bottom: 34px;\\n      width: min(280px, 70%);\\n      padding: 22px;\\n      border-radius: 26px;\\n      background: linear-gradient(180deg, #102844 0%, #0b2036 100%);\\n      color: var(--rm-text);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      box-shadow: var(--rm-shadow);\\n      animation: rmFloatSmall 5s ease-in-out infinite;\\n    }\\n\\n    .rm-badge strong {\\n      display: block;\\n      font-size: 42px;\\n      line-height: 1;\\n      color: var(--rm-orange);\\n      letter-spacing: -0.04em;\\n    }\\n\\n    .rm-badge span {\\n      display: block;\\n      margin-top: 8px;\\n      color: var(--rm-muted);\\n      font-weight: 800;\\n      line-height: 1.45;\\n    }\\n\\n    .rm-nav-strip {\\n      margin-top: -52px;\\n      position: relative;\\n      z-index: 5;\\n    }\\n\\n    .rm-nav-box {\\n      display: grid;\\n      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);\\n      gap: 1px;\\n      border-radius: 30px;\\n      overflow: hidden;\\n      background: rgba(255, 255, 255, 0.08);\\n      box-shadow: var(--rm-shadow);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n    }\\n\\n    .rm-nav-main {\\n      padding: 26px;\\n      background: linear-gradient(180deg, #132c48 0%, #0d2138 100%);\\n    }\\n\\n    .rm-nav-main strong {\\n      display: block;\\n      color: var(--rm-white);\\n      font-size: 25px;\\n      line-height: 1.1;\\n      letter-spacing: -0.03em;\\n    }\\n\\n    .rm-nav-main span {\\n      display: block;\\n      margin-top: 8px;\\n      color: var(--rm-muted);\\n      line-height: 1.55;\\n    }\\n\\n    .rm-nav-links {\\n      display: grid;\\n      grid-template-columns: repeat(4, minmax(0, 1fr));\\n      gap: 1px;\\n      background: rgba(255, 255, 255, 0.08);\\n    }\\n\\n    .rm-nav-links a {\\n      min-height: 122px;\\n      display: flex;\\n      flex-direction: column;\\n      justify-content: space-between;\\n      padding: 22px;\\n      background: linear-gradient(180deg, #10243b 0%, #0b1d30 100%);\\n      transition: background 0.25s ease, transform 0.25s ease;\\n    }\\n\\n    .rm-nav-links a:hover {\\n      background: linear-gradient(180deg, #173555 0%, #102844 100%);\\n    }\\n\\n    .rm-nav-links b {\\n      color: var(--rm-white);\\n      font-size: 18px;\\n      letter-spacing: -0.02em;\\n    }\\n\\n    .rm-nav-links small {\\n      color: var(--rm-orange-2);\\n      font-weight: 900;\\n    }\\n\\n    .rm-head {\\n      display: grid;\\n      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);\\n      gap: 34px;\\n      align-items: end;\\n      margin-bottom: 38px;\\n    }\\n\\n    .rm-head h2 {\\n      margin: 16px 0 0;\\n      color: var(--rm-white);\\n      font-size: clamp(34px, 4.5vw, 56px);\\n      line-height: 1;\\n      letter-spacing: -0.05em;\\n      font-weight: 950;\\n    }\\n\\n    .rm-head p {\\n      margin: 0;\\n      color: #c9d6e6;\\n      font-size: 18px;\\n      line-height: 1.68;\\n    }\\n\\n    .rm-what {\\n      background:\\n        radial-gradient(circle at 86% 16%, rgba(240, 154, 55, 0.1), transparent 28%),\\n        linear-gradient(180deg, var(--rm-bg-2), var(--rm-bg));\\n    }\\n\\n    .rm-content-grid {\\n      display: grid;\\n      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);\\n      gap: 24px;\\n      align-items: stretch;\\n    }\\n\\n    .rm-info-card {\\n      padding: clamp(28px, 4vw, 46px);\\n      border-radius: 34px;\\n      background: linear-gradient(180deg, var(--rm-card-2) 0%, var(--rm-card) 100%);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      box-shadow: 0 18px 55px rgba(0, 0, 0, 0.2);\\n    }\\n\\n    .rm-info-card h3 {\\n      margin: 0 0 16px;\\n      color: var(--rm-white);\\n      font-size: clamp(28px, 3.6vw, 46px);\\n      line-height: 1;\\n      letter-spacing: -0.05em;\\n      font-weight: 950;\\n    }\\n\\n    .rm-info-card p {\\n      margin: 0 0 18px;\\n      color: var(--rm-muted);\\n      font-size: 18px;\\n      line-height: 1.72;\\n    }\\n\\n    .rm-info-card p:last-child {\\n      margin-bottom: 0;\\n    }\\n\\n    .rm-panel-visual {\\n      min-height: 100%;\\n      padding: 28px;\\n      border-radius: 34px;\\n      background:\\n        radial-gradient(circle at 28% 20%, rgba(25, 211, 211, 0.14), transparent 30%),\\n        linear-gradient(180deg, #10243b 0%, #0b1d30 100%);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      box-shadow: var(--rm-shadow);\\n      display: flex;\\n      flex-direction: column;\\n      justify-content: center;\\n      gap: 16px;\\n    }\\n\\n    .rm-mini-screen {\\n      min-height: 132px;\\n      border-radius: 24px;\\n      background: linear-gradient(135deg, rgba(255,255,255,.08), rgba(255,255,255,.02));\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      padding: 22px;\\n      display: grid;\\n      grid-template-columns: 70px 1fr;\\n      gap: 16px;\\n      align-items: center;\\n    }\\n\\n    .rm-mini-icon {\\n      width: 70px;\\n      height: 70px;\\n      border-radius: 22px;\\n      display: grid;\\n      place-items: center;\\n      background: linear-gradient(135deg, rgba(240,154,55,.22), rgba(25,211,211,.12));\\n      color: var(--rm-orange-2);\\n      font-size: 34px;\\n      border: 1px solid rgba(255,255,255,.09);\\n    }\\n\\n    .rm-mini-screen strong {\\n      display: block;\\n      color: var(--rm-white);\\n      font-size: 20px;\\n      line-height: 1.18;\\n    }\\n\\n    .rm-mini-screen span {\\n      display: block;\\n      margin-top: 6px;\\n      color: var(--rm-muted);\\n      line-height: 1.5;\\n    }\\n\\n    .rm-features {\\n      background:\\n        radial-gradient(circle at 18% 20%, rgba(240, 154, 55, 0.12), transparent 28%),\\n        linear-gradient(135deg, #04111d 0%, #0a1f34 100%);\\n    }\\n\\n    .rm-feature-grid {\\n      display: grid;\\n      grid-template-columns: repeat(4, minmax(0, 1fr));\\n      gap: 18px;\\n    }\\n\\n    .rm-feature-card {\\n      min-height: 276px;\\n      padding: 28px;\\n      border-radius: 30px;\\n      background: rgba(255, 255, 255, 0.05);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      backdrop-filter: blur(14px);\\n      box-shadow: 0 16px 46px rgba(0, 0, 0, 0.16);\\n      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;\\n    }\\n\\n    .rm-feature-card:hover {\\n      transform: translateY(-6px);\\n      border-color: rgba(240, 154, 55, 0.25);\\n      box-shadow: 0 22px 56px rgba(0, 0, 0, 0.22);\\n    }\\n\\n    .rm-feature-icon {\\n      width: 58px;\\n      height: 58px;\\n      border-radius: 20px;\\n      display: grid;\\n      place-items: center;\\n      margin-bottom: 20px;\\n      background: linear-gradient(135deg, var(--rm-orange), var(--rm-orange-2));\\n      color: #071423;\\n      font-size: 27px;\\n      font-weight: 900;\\n    }\\n\\n    .rm-feature-card h3 {\\n      margin: 0 0 12px;\\n      color: var(--rm-white);\\n      font-size: 23px;\\n      line-height: 1.12;\\n      letter-spacing: -0.03em;\\n      font-weight: 950;\\n    }\\n\\n    .rm-feature-card p {\\n      margin: 0;\\n      color: rgba(255, 255, 255, 0.76);\\n      line-height: 1.65;\\n    }\\n\\n    .rm-brands {\\n      background: var(--rm-bg);\\n    }\\n\\n    .rm-brand-grid {\\n      display: grid;\\n      grid-template-columns: repeat(4, minmax(0, 1fr));\\n      gap: 16px;\\n    }\\n\\n    .rm-brand-card {\\n      min-height: 220px;\\n      padding: 28px;\\n      border-radius: 30px;\\n      background: linear-gradient(180deg, #10243b 0%, #0b1d30 100%);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      box-shadow: 0 16px 44px rgba(0, 0, 0, 0.18);\\n      transition: transform 0.25s ease, border-color 0.25s ease;\\n    }\\n\\n    .rm-brand-card:hover {\\n      transform: translateY(-5px);\\n      border-color: rgba(240, 154, 55, 0.26);\\n    }\\n\\n    .rm-brand-card strong {\\n      display: block;\\n      margin-bottom: 14px;\\n      color: var(--rm-orange-2);\\n      font-size: 29px;\\n      letter-spacing: -0.04em;\\n      line-height: 1;\\n      font-weight: 950;\\n    }\\n\\n    .rm-brand-card p {\\n      margin: 0;\\n      color: var(--rm-muted);\\n      line-height: 1.65;\\n    }\\n\\n    .rm-guide {\\n      background:\\n        radial-gradient(circle at 80% 22%, rgba(25, 211, 211, 0.1), transparent 28%),\\n        linear-gradient(180deg, var(--rm-bg-2), var(--rm-bg));\\n    }\\n\\n    .rm-guide-grid {\\n      display: grid;\\n      grid-template-columns: repeat(3, minmax(0, 1fr));\\n      gap: 18px;\\n      counter-reset: guide;\\n    }\\n\\n    .rm-guide-card {\\n      position: relative;\\n      min-height: 270px;\\n      padding: 28px;\\n      border-radius: 30px;\\n      background: linear-gradient(180deg, var(--rm-card-2) 0%, var(--rm-card) 100%);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      box-shadow: 0 16px 46px rgba(0, 0, 0, 0.16);\\n      overflow: hidden;\\n    }\\n\\n    .rm-guide-card::before {\\n      counter-increment: guide;\\n      content: counter(guide, decimal-leading-zero);\\n      display: inline-flex;\\n      width: 54px;\\n      height: 54px;\\n      align-items: center;\\n      justify-content: center;\\n      margin-bottom: 20px;\\n      border-radius: 18px;\\n      color: #071423;\\n      background: linear-gradient(135deg, var(--rm-orange), var(--rm-orange-2));\\n      font-weight: 950;\\n      font-size: 18px;\\n    }\\n\\n    .rm-guide-card h3 {\\n      margin: 0 0 12px;\\n      color: var(--rm-white);\\n      font-size: 24px;\\n      line-height: 1.15;\\n      letter-spacing: -0.03em;\\n      font-weight: 950;\\n    }\\n\\n    .rm-guide-card p {\\n      margin: 0;\\n      color: var(--rm-muted);\\n      line-height: 1.66;\\n    }\\n\\n    .rm-cta {\\n      padding: 84px 0;\\n      background:\\n        radial-gradient(circle at 20% 20%, rgba(240, 154, 55, 0.16), transparent 26%),\\n        linear-gradient(135deg, #04111d 0%, #091d31 100%);\\n      color: var(--rm-white);\\n    }\\n\\n    .rm-cta-box {\\n      display: grid;\\n      grid-template-columns: minmax(0, 1fr) auto;\\n      gap: 32px;\\n      align-items: center;\\n      padding: clamp(30px, 5vw, 58px);\\n      border-radius: 36px;\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      background: rgba(255, 255, 255, 0.05);\\n      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22);\\n      backdrop-filter: blur(12px);\\n    }\\n\\n    .rm-cta h2 {\\n      margin: 0 0 14px;\\n      font-size: clamp(34px, 4.5vw, 60px);\\n      line-height: 1;\\n      letter-spacing: -0.05em;\\n      font-weight: 950;\\n      color: var(--rm-white);\\n    }\\n\\n    .rm-cta h2 span {\\n      display: block;\\n      color: var(--rm-orange-2);\\n    }\\n\\n    .rm-cta p {\\n      margin: 0;\\n      color: rgba(255, 255, 255, 0.78);\\n      font-size: 18px;\\n      line-height: 1.7;\\n    }\\n\\n    .rm-faq {\\n      background: var(--rm-bg);\\n    }\\n\\n    .rm-faq-grid {\\n      display: grid;\\n      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);\\n      gap: 28px;\\n      align-items: start;\\n    }\\n\\n    .rm-faq-list {\\n      display: grid;\\n      gap: 12px;\\n    }\\n\\n    .rm-faq-item {\\n      border-radius: 24px;\\n      background: linear-gradient(180deg, #10243b 0%, #0b1d30 100%);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      overflow: hidden;\\n      box-shadow: 0 14px 38px rgba(0, 0, 0, 0.13);\\n    }\\n\\n    .rm-faq-question {\\n      width: 100%;\\n      min-height: 68px;\\n      padding: 20px 58px 20px 22px;\\n      border: 0;\\n      background: transparent;\\n      color: var(--rm-white);\\n      text-align: left;\\n      cursor: pointer;\\n      font-weight: 950;\\n      font-size: 18px;\\n      line-height: 1.35;\\n      position: relative;\\n    }\\n\\n    .rm-faq-question::after {\\n      content: \\\"+\\\";\\n      position: absolute;\\n      right: 22px;\\n      top: 50%;\\n      transform: translateY(-50%);\\n      width: 30px;\\n      height: 30px;\\n      border-radius: 50%;\\n      display: grid;\\n      place-items: center;\\n      background: rgba(240, 154, 55, 0.13);\\n      color: var(--rm-orange-2);\\n      font-size: 22px;\\n      line-height: 1;\\n    }\\n\\n    .rm-faq-item.active .rm-faq-question::after {\\n      content: \\\"\\u2212\\\";\\n    }\\n\\n    .rm-faq-answer {\\n      display: none;\\n      padding: 0 22px 22px;\\n      color: var(--rm-muted);\\n      line-height: 1.7;\\n      font-size: 16px;\\n    }\\n\\n    .rm-faq-item.active .rm-faq-answer {\\n      display: block;\\n      animation: rmFade 0.25s ease both;\\n    }\\n\\n    .rm-related {\\n      background:\\n        radial-gradient(circle at 20% 20%, rgba(240, 154, 55, 0.1), transparent 28%),\\n        linear-gradient(135deg, #04111d 0%, #0a1f34 100%);\\n    }\\n\\n    .rm-related-grid {\\n      display: grid;\\n      grid-template-columns: repeat(3, minmax(0, 1fr));\\n      gap: 18px;\\n    }\\n\\n    .rm-related-card {\\n      min-height: 230px;\\n      padding: 28px;\\n      border-radius: 30px;\\n      background: rgba(255, 255, 255, 0.05);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      backdrop-filter: blur(14px);\\n      transition: transform 0.25s ease, border-color 0.25s ease;\\n    }\\n\\n    .rm-related-card:hover {\\n      transform: translateY(-5px);\\n      border-color: rgba(240, 154, 55, 0.24);\\n    }\\n\\n    .rm-related-card .rm-related-icon {\\n      width: 58px;\\n      height: 58px;\\n      margin-bottom: 18px;\\n      border-radius: 20px;\\n      display: grid;\\n      place-items: center;\\n      font-size: 27px;\\n      background: linear-gradient(135deg, rgba(240,154,55,.22), rgba(25,211,211,.12));\\n      border: 1px solid rgba(255,255,255,.09);\\n    }\\n\\n    .rm-related-card h3 {\\n      margin: 0 0 12px;\\n      color: var(--rm-white);\\n      font-size: 24px;\\n      line-height: 1.15;\\n      letter-spacing: -0.03em;\\n      font-weight: 950;\\n    }\\n\\n    .rm-related-card p {\\n      margin: 0;\\n      color: rgba(255,255,255,.76);\\n      line-height: 1.65;\\n    }\\n\\n    .rm-sticky-whatsapp {\\n      position: fixed;\\n      right: 18px;\\n      bottom: 18px;\\n      z-index: 999;\\n      width: 58px;\\n      height: 58px;\\n      border-radius: 50%;\\n      display: grid;\\n      place-items: center;\\n      color: #061423;\\n      background: linear-gradient(135deg, #25d366, #8effbb);\\n      box-shadow: 0 16px 40px rgba(37, 211, 102, 0.35);\\n      font-size: 26px;\\n      font-weight: 950;\\n      transition: transform 0.25s ease;\\n    }\\n\\n    .rm-sticky-whatsapp:hover {\\n      transform: translateY(-4px) scale(1.03);\\n    }\\n\\n    @keyframes rmFloat {\\n      0%, 100% {\\n        transform: translateY(0) rotate(1deg);\\n      }\\n      50% {\\n        transform: translateY(-14px) rotate(1deg);\\n      }\\n    }\\n\\n    @keyframes rmFloatSmall {\\n      0%, 100% {\\n        transform: translateY(0);\\n      }\\n      50% {\\n        transform: translateY(-8px);\\n      }\\n    }\\n\\n    @keyframes rmFade {\\n      from {\\n        opacity: 0;\\n        transform: translateY(8px);\\n      }\\n      to {\\n        opacity: 1;\\n        transform: translateY(0);\\n      }\\n    }\\n\\n    @media (max-width: 1100px) {\\n      .rm-feature-grid,\\n      .rm-brand-grid {\\n        grid-template-columns: repeat(2, minmax(0, 1fr));\\n      }\\n\\n      .rm-guide-grid {\\n        grid-template-columns: repeat(2, minmax(0, 1fr));\\n      }\\n    }\\n\\n    @media (max-width: 980px) {\\n      .rm-hero {\\n        min-height: auto;\\n        padding: 54px 0 92px;\\n      }\\n\\n      .rm-hero-grid,\\n      .rm-nav-box,\\n      .rm-head,\\n      .rm-content-grid,\\n      .rm-cta-box,\\n      .rm-faq-grid {\\n        grid-template-columns: 1fr;\\n      }\\n\\n      .rm-nav-links {\\n        grid-template-columns: repeat(2, minmax(0, 1fr));\\n      }\\n\\n      .rm-related-grid {\\n        grid-template-columns: 1fr;\\n      }\\n\\n      .rm-cta-box {\\n        text-align: left;\\n      }\\n    }\\n\\n    @media (max-width: 720px) {\\n      .rm-section {\\n        padding: 64px 0;\\n      }\\n\\n      .rm-brand {\\n        width: 178px;\\n      }\\n\\n      .rm-hero h1 {\\n        font-size: clamp(39px, 12vw, 54px);\\n      }\\n\\n      .rm-actions {\\n        flex-direction: column;\\n      }\\n\\n      .rm-btn {\\n        width: 100%;\\n      }\\n\\n      .rm-badge {\\n        position: relative;\\n        left: auto;\\n        bottom: auto;\\n        width: 100%;\\n        margin-top: 18px;\\n      }\\n\\n      .rm-nav-strip {\\n        margin-top: -38px;\\n      }\\n\\n      .rm-feature-grid,\\n      .rm-brand-grid,\\n      .rm-guide-grid,\\n      .rm-nav-links {\\n        grid-template-columns: 1fr;\\n      }\\n\\n      .rm-nav-links a {\\n        min-height: 104px;\\n      }\\n\\n      .rm-mini-screen {\\n        grid-template-columns: 1fr;\\n      }\\n\\n      .rm-monitor-screen {\\n        min-height: 250px;\\n      }\\n    }\\n\\n    @media (max-width: 520px) {\\n      .rm-wrap {\\n        width: min(100% - 22px, 1180px);\\n      }\\n\\n      .rm-hero {\\n        padding-top: 38px;\\n      }\\n\\n      .rm-eyebrow {\\n        border-radius: 18px;\\n        font-size: 11.5px;\\n        letter-spacing: 0.03em;\\n      }\\n\\n      .rm-info-card,\\n      .rm-panel-visual,\\n      .rm-feature-card,\\n      .rm-brand-card,\\n      .rm-guide-card,\\n      .rm-related-card {\\n        padding: 24px;\\n        border-radius: 26px;\\n      }\\n\\n      .rm-cta-box {\\n        border-radius: 28px;\\n      }\\n\\n      .rm-sticky-whatsapp {\\n        right: 14px;\\n        bottom: 14px;\\n        width: 54px;\\n        height: 54px;\\n      }\\n    }\\n  <\\\/style>\\n\\n  <section class=\\\"rm-hero\\\" id=\\\"inicio\\\">\\n    <div class=\\\"rm-wrap\\\">\\n      <div class=\\\"rm-hero-grid\\\">\\n        <div>\\n          <div class=\\\"rm-brand\\\">\\n            <img src=\\\"https:\\\/\\\/raditech.mx\\\/wp-content\\\/uploads\\\/2024\\\/11\\\/raditech-logo-nombre.svg\\\" alt=\\\"Raditech\\\">\\n          <\\\/div>\\n\\n          <span class=\\\"rm-eyebrow\\\">Monitores M\\u00e9dicos para Radiolog\\u00eda<\\\/span>\\n\\n          <h1>\\n            Monitores Grado M\\u00e9dico\\n            <span>para Diagn\\u00f3stico Radiol\\u00f3gico de Alta Precisi\\u00f3n<\\\/span>\\n          <\\\/h1>\\n\\n          <p>\\n            Estaciones de trabajo con monitores m\\u00e9dicos certificados para la interpretaci\\u00f3n de estudios DICOM: rayos X, TAC, resonancia magn\\u00e9tica y medicina nuclear. Compatibles con cualquier PACS\\\/RIS.\\n          <\\\/p>\\n\\n          <div class=\\\"rm-actions\\\">\\n            <a class=\\\"rm-btn rm-btn-whatsapp\\\" href=\\\"https:\\\/\\\/wa.me\\\/5215534449236\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">WhatsApp Directo<\\\/a>\\n            <a class=\\\"rm-btn rm-btn-primary\\\" href=\\\"#cotizar\\\">Solicitar Cotizaci\\u00f3n<\\\/a>\\n          <\\\/div>\\n        <\\\/div>\\n\\n        <div class=\\\"rm-hero-card\\\">\\n          <div class=\\\"rm-monitor-visual\\\">\\n            <div class=\\\"rm-monitor-screen\\\">\\n              <div class=\\\"rm-dicom-lines\\\"><\\\/div>\\n            <\\\/div>\\n            <div class=\\\"rm-monitor-stem\\\"><\\\/div>\\n            <div class=\\\"rm-monitor-base\\\"><\\\/div>\\n          <\\\/div>\\n\\n          <div class=\\\"rm-badge\\\">\\n            <strong>400+<\\\/strong>\\n            <span>Hospitales equipados en M\\u00e9xico<\\\/span>\\n          <\\\/div>\\n        <\\\/div>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section class=\\\"rm-nav-strip\\\">\\n    <div class=\\\"rm-wrap\\\">\\n      <div class=\\\"rm-nav-box\\\">\\n        <div class=\\\"rm-nav-main\\\">\\n          <strong>Monitores M\\u00e9dicos \\u00b7 Raditech<\\\/strong>\\n          <span>Soluciones certificadas para diagn\\u00f3stico radiol\\u00f3gico, visualizaci\\u00f3n DICOM y estaciones de trabajo profesionales.<\\\/span>\\n        <\\\/div>\\n\\n        <div class=\\\"rm-nav-links\\\">\\n          <a href=\\\"#que-son\\\">\\n            <b>\\u00bfQu\\u00e9 son?<\\\/b>\\n            <small>Conocer \\u2192<\\\/small>\\n          <\\\/a>\\n\\n          <a href=\\\"#marcas\\\">\\n            <b>Marcas<\\\/b>\\n            <small>Ver opciones \\u2192<\\\/small>\\n          <\\\/a>\\n\\n          <a href=\\\"#guia\\\">\\n            <b>C\\u00f3mo elegir<\\\/b>\\n            <small>Gu\\u00eda r\\u00e1pida \\u2192<\\\/small>\\n          <\\\/a>\\n\\n          <a href=\\\"#cotizar\\\">\\n            <b>Cotizar<\\\/b>\\n            <small>WhatsApp \\u2192<\\\/small>\\n          <\\\/a>\\n        <\\\/div>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section class=\\\"rm-section rm-what\\\" id=\\\"que-son\\\">\\n    <div class=\\\"rm-wrap\\\">\\n      <div class=\\\"rm-head\\\">\\n        <div>\\n          <span class=\\\"rm-eyebrow\\\">Tecnolog\\u00eda de Diagn\\u00f3stico<\\\/span>\\n          <h2>\\u00bfQu\\u00e9 son los monitores de grado m\\u00e9dico?<\\\/h2>\\n        <\\\/div>\\n\\n        <p>\\n          Visualizaci\\u00f3n especializada para interpretar im\\u00e1genes m\\u00e9dicas con precisi\\u00f3n diagn\\u00f3stica, estabilidad y compatibilidad con flujos DICOM.\\n        <\\\/p>\\n      <\\\/div>\\n\\n      <div class=\\\"rm-content-grid\\\">\\n        <article class=\\\"rm-info-card\\\">\\n          <h3>Imagen m\\u00e9dica con precisi\\u00f3n cl\\u00ednica.<\\\/h3>\\n\\n          <p>\\n            Los monitores m\\u00e9dicos para radiolog\\u00eda est\\u00e1n dise\\u00f1ados espec\\u00edficamente para visualizar y analizar im\\u00e1genes DICOM de diagn\\u00f3stico: radiograf\\u00edas, tomograf\\u00edas y resonancias magn\\u00e9ticas. Se caracterizan por alta resoluci\\u00f3n, amplia gama de colores y contraste preciso que permite a los radi\\u00f3logos ver detalles finos.\\n          <\\\/p>\\n\\n          <p>\\n            A diferencia de un monitor comercial, los monitores de grado m\\u00e9dico est\\u00e1n calibrados seg\\u00fan est\\u00e1ndares DICOM Part 14 y cumplen con las certificaciones requeridas por la normativa mexicana para el diagn\\u00f3stico cl\\u00ednico.\\n          <\\\/p>\\n\\n          <p>\\n            Tambi\\u00e9n se utilizan para visualizar im\\u00e1genes en tiempo real durante procedimientos como fluoroscopia y angiograf\\u00eda, guiando al m\\u00e9dico con precisi\\u00f3n durante la intervenci\\u00f3n.\\n          <\\\/p>\\n\\n          <div class=\\\"rm-actions\\\">\\n            <a class=\\\"rm-btn rm-btn-primary\\\" href=\\\"https:\\\/\\\/raditech.mx\\\/pacs-ris\\\/\\\">Ver VIRA PACS-RIS<\\\/a>\\n          <\\\/div>\\n        <\\\/article>\\n\\n        <div class=\\\"rm-panel-visual\\\">\\n          <div class=\\\"rm-mini-screen\\\">\\n            <div class=\\\"rm-mini-icon\\\">D<\\\/div>\\n            <div>\\n              <strong>DICOM Part 14<\\\/strong>\\n              <span>Calibraci\\u00f3n orientada a escala de grises, contraste y visualizaci\\u00f3n diagn\\u00f3stica.<\\\/span>\\n            <\\\/div>\\n          <\\\/div>\\n\\n          <div class=\\\"rm-mini-screen\\\">\\n            <div class=\\\"rm-mini-icon\\\">P<\\\/div>\\n            <div>\\n              <strong>PACS\\\/RIS<\\\/strong>\\n              <span>Integraci\\u00f3n con sistemas de almacenamiento, visor web, gesti\\u00f3n radiol\\u00f3gica y teleradiolog\\u00eda.<\\\/span>\\n            <\\\/div>\\n          <\\\/div>\\n\\n          <div class=\\\"rm-mini-screen\\\">\\n            <div class=\\\"rm-mini-icon\\\">M<\\\/div>\\n            <div>\\n              <strong>Modalidades m\\u00e9dicas<\\\/strong>\\n              <span>Rayos X, TAC, resonancia magn\\u00e9tica, medicina nuclear, fluoroscopia y angiograf\\u00eda.<\\\/span>\\n            <\\\/div>\\n          <\\\/div>\\n        <\\\/div>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section class=\\\"rm-section rm-features\\\" id=\\\"caracteristicas\\\">\\n    <div class=\\\"rm-wrap\\\">\\n      <div class=\\\"rm-head\\\">\\n        <div>\\n          <span class=\\\"rm-eyebrow\\\">Caracter\\u00edsticas T\\u00e9cnicas<\\\/span>\\n          <h2>Todo lo que necesita un monitor m\\u00e9dico certificado.<\\\/h2>\\n        <\\\/div>\\n\\n        <p>\\n          Cada vida es \\u00fanica. En Raditech proporcionamos monitores innovadores para el diagn\\u00f3stico m\\u00e1s preciso, colaborando con las principales marcas del mercado.\\n        <\\\/p>\\n      <\\\/div>\\n\\n      <div class=\\\"rm-feature-grid\\\">\\n        <article class=\\\"rm-feature-card\\\">\\n          <div class=\\\"rm-feature-icon\\\">\\ud83d\\udda5\\ufe0f<\\\/div>\\n          <h3>Alta Resoluci\\u00f3n DICOM<\\\/h3>\\n          <p>Calibraci\\u00f3n DICOM Part 14 para visualizaci\\u00f3n precisa de detalles finos en im\\u00e1genes de diagn\\u00f3stico.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rm-feature-card\\\">\\n          <div class=\\\"rm-feature-icon\\\">\\ud83c\\udfa8<\\\/div>\\n          <h3>Precisi\\u00f3n de Color<\\\/h3>\\n          <p>Amplia gama de colores y contraste preciso para interpretaci\\u00f3n confiable de patolog\\u00edas.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rm-feature-card\\\">\\n          <div class=\\\"rm-feature-icon\\\">\\u23f1\\ufe0f<\\\/div>\\n          <h3>Estabilidad Temporal<\\\/h3>\\n          <p>Calibraci\\u00f3n autom\\u00e1tica que mantiene la consistencia de imagen durante la vida \\u00fatil del monitor.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rm-feature-card\\\">\\n          <div class=\\\"rm-feature-icon\\\">\\ud83d\\udd17<\\\/div>\\n          <h3>Integraci\\u00f3n PACS\\\/RIS<\\\/h3>\\n          <p>Compatible con VIRA PACS-RIS y cualquier sistema de archivado y gesti\\u00f3n de im\\u00e1genes del mercado.<\\\/p>\\n        <\\\/article>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section class=\\\"rm-section rm-brands\\\" id=\\\"marcas\\\">\\n    <div class=\\\"rm-wrap\\\">\\n      <div class=\\\"rm-head\\\">\\n        <div>\\n          <span class=\\\"rm-eyebrow\\\">Marcas Disponibles<\\\/span>\\n          <h2>Los monitores grado m\\u00e9dico que manejamos.<\\\/h2>\\n        <\\\/div>\\n\\n        <p>\\n          Junto con Raditech, nuestros monitores m\\u00e9dicos est\\u00e1n a la vanguardia de la tecnolog\\u00eda de im\\u00e1genes m\\u00e9dicas, proporcionando visualizaci\\u00f3n \\u00f3ptima e integraci\\u00f3n inteligente para el diagn\\u00f3stico m\\u00e1s preciso. Garantizamos un diagn\\u00f3stico m\\u00e1s eficaz, reducci\\u00f3n en la tasa de errores y cumplimiento con las certificaciones y leyes vigentes en M\\u00e9xico.\\n        <\\\/p>\\n      <\\\/div>\\n\\n      <div class=\\\"rm-brand-grid\\\">\\n        <article class=\\\"rm-brand-card\\\">\\n          <strong>Barco<\\\/strong>\\n          <p>Monitores m\\u00e9dicos de alta calidad con sistemas de visualizaci\\u00f3n 3D para radiolog\\u00eda.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rm-brand-card\\\">\\n          <strong>Eizo<\\\/strong>\\n          <p>Alta precisi\\u00f3n de color y gran estabilidad temporal para diagn\\u00f3stico de confianza.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rm-brand-card\\\">\\n          <strong>NEC<\\\/strong>\\n          <p>Monitores m\\u00e9dicos con precisi\\u00f3n de color y estabilidad certificada para radiolog\\u00eda.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rm-brand-card\\\">\\n          <strong>LG \\u00b7 Dell<\\\/strong>\\n          <p>Opciones con gran precisi\\u00f3n de color y estabilidad para entornos de diagn\\u00f3stico.<\\\/p>\\n        <\\\/article>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section class=\\\"rm-section rm-guide\\\" id=\\\"guia\\\">\\n    <div class=\\\"rm-wrap\\\">\\n      <div class=\\\"rm-head\\\">\\n        <div>\\n          <span class=\\\"rm-eyebrow\\\">Gu\\u00eda de Compra<\\\/span>\\n          <h2>\\u00bfC\\u00f3mo elegir el mejor monitor m\\u00e9dico para radiolog\\u00eda?<\\\/h2>\\n        <\\\/div>\\n\\n        <p>\\n          Existen varios factores clave al seleccionar un monitor m\\u00e9dico para su \\u00e1rea de imagen.\\n        <\\\/p>\\n      <\\\/div>\\n\\n      <div class=\\\"rm-guide-grid\\\">\\n        <article class=\\\"rm-guide-card\\\">\\n          <h3>Resoluci\\u00f3n<\\\/h3>\\n          <p>Elija alta resoluci\\u00f3n para ver detalles finos en im\\u00e1genes de diagn\\u00f3stico: al menos 2MP para radiograf\\u00eda general, 5MP para mamograf\\u00eda.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rm-guide-card\\\">\\n          <h3>Calidad de Imagen<\\\/h3>\\n          <p>Amplia gama de colores y contraste preciso, con relaci\\u00f3n de contraste m\\u00ednima 850:1, para interpretaci\\u00f3n diagn\\u00f3stica confiable.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rm-guide-card\\\">\\n          <h3>Estabilidad<\\\/h3>\\n          <p>Calibraci\\u00f3n autom\\u00e1tica y sensor de luminancia integrado que mantiene consistencia a lo largo del tiempo sin intervenci\\u00f3n manual.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rm-guide-card\\\">\\n          <h3>Certificaciones<\\\/h3>\\n          <p>Cumplimiento con DICOM Part 14, CE m\\u00e9dico y requisitos NOM mexicanas para uso cl\\u00ednico en hospitales y cl\\u00ednicas.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rm-guide-card\\\">\\n          <h3>Integraci\\u00f3n<\\\/h3>\\n          <p>Compatibilidad con su PACS\\\/RIS actual y soporte para flujos de trabajo DICOM sin necesidad de infraestructura adicional.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rm-guide-card\\\">\\n          <h3>Soporte T\\u00e9cnico<\\\/h3>\\n          <p>Servicio de calibraci\\u00f3n peri\\u00f3dica, garant\\u00eda y soporte local para cumplir con auditor\\u00edas y certificaciones de calidad.<\\\/p>\\n        <\\\/article>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section class=\\\"rm-cta\\\" id=\\\"cotizar\\\">\\n    <div class=\\\"rm-wrap\\\">\\n      <div class=\\\"rm-cta-box\\\">\\n        <div>\\n          <h2>\\n            Equipa tu \\u00e1rea de imagen\\n            <span>con monitores certificados.<\\\/span>\\n          <\\\/h2>\\n          <p>\\n            M\\u00e1s de 400 hospitales en M\\u00e9xico ya conf\\u00edan en Raditech. Sin costo de implementaci\\u00f3n, activaci\\u00f3n en 48 horas.\\n          <\\\/p>\\n        <\\\/div>\\n\\n        <div class=\\\"rm-actions\\\">\\n          <a class=\\\"rm-btn rm-btn-whatsapp\\\" href=\\\"https:\\\/\\\/wa.me\\\/5215534449236\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">WhatsApp<\\\/a>\\n          <a class=\\\"rm-btn rm-btn-primary\\\" href=\\\"https:\\\/\\\/wa.me\\\/5215534449236?text=Hola%2C%20quiero%20cotizar%20monitores%20m%C3%A9dicos%20grado%20radiolog%C3%ADa\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Cotizar<\\\/a>\\n        <\\\/div>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section class=\\\"rm-section rm-faq\\\" id=\\\"faq\\\">\\n    <div class=\\\"rm-wrap\\\">\\n      <div class=\\\"rm-faq-grid\\\">\\n        <div>\\n          <span class=\\\"rm-eyebrow\\\">Preguntas Frecuentes<\\\/span>\\n          <div class=\\\"rm-head\\\" style=\\\"display:block;margin-bottom:0;\\\">\\n            <h2>Dudas sobre monitores m\\u00e9dicos para radiolog\\u00eda.<\\\/h2>\\n          <\\\/div>\\n        <\\\/div>\\n\\n        <div class=\\\"rm-faq-list\\\">\\n          <article class=\\\"rm-faq-item active\\\">\\n            <button class=\\\"rm-faq-question\\\" type=\\\"button\\\">\\u00bfCu\\u00e1l es la diferencia entre un monitor m\\u00e9dico y uno comercial?<\\\/button>\\n            <div class=\\\"rm-faq-answer\\\">\\n              Los monitores m\\u00e9dicos est\\u00e1n calibrados seg\\u00fan el est\\u00e1ndar DICOM Part 14, con mayor luminancia, contraste y estabilidad temporal que los monitores comerciales. Son requisito en instalaciones de diagn\\u00f3stico para cumplir normativas m\\u00e9dicas.\\n            <\\\/div>\\n          <\\\/article>\\n\\n          <article class=\\\"rm-faq-item\\\">\\n            <button class=\\\"rm-faq-question\\\" type=\\\"button\\\">\\u00bfQu\\u00e9 resoluci\\u00f3n necesito para interpretar estudios DICOM?<\\\/button>\\n            <div class=\\\"rm-faq-answer\\\">\\n              Para radiograf\\u00eda general se recomienda 2 megap\\u00edxeles, equivalente a 1600\\u00d71200. Para mamograf\\u00eda digital se requieren 5 megap\\u00edxeles. Para TAC y RM, 2-3MP son suficientes con una buena calibraci\\u00f3n de contraste.\\n            <\\\/div>\\n          <\\\/article>\\n\\n          <article class=\\\"rm-faq-item\\\">\\n            <button class=\\\"rm-faq-question\\\" type=\\\"button\\\">\\u00bfLos monitores son compatibles con mi PACS actual?<\\\/button>\\n            <div class=\\\"rm-faq-answer\\\">\\n              S\\u00ed. Todos los monitores que manejamos son compatibles con el est\\u00e1ndar DICOM e integran directamente con VIRA PACS-RIS y cualquier sistema del mercado.\\n            <\\\/div>\\n          <\\\/article>\\n\\n          <article class=\\\"rm-faq-item\\\">\\n            <button class=\\\"rm-faq-question\\\" type=\\\"button\\\">\\u00bfCada cu\\u00e1nto tiempo se calibra un monitor m\\u00e9dico?<\\\/button>\\n            <div class=\\\"rm-faq-answer\\\">\\n              Se recomienda calibraci\\u00f3n mensual autom\\u00e1tica con sensor integrado y calibraci\\u00f3n manual semestral. Raditech ofrece servicio de calibraci\\u00f3n y mantenimiento incluido en el contrato, seg\\u00fan las gu\\u00edas de la AAPM.\\n            <\\\/div>\\n          <\\\/article>\\n\\n          <article class=\\\"rm-faq-item\\\">\\n            <button class=\\\"rm-faq-question\\\" type=\\\"button\\\">\\u00bfQu\\u00e9 marcas de monitores m\\u00e9dicos manejan?<\\\/button>\\n            <div class=\\\"rm-faq-answer\\\">\\n              Trabajamos con Barco, Eizo, NEC, LG y Dell, marcas l\\u00edderes en monitores de grado m\\u00e9dico con soporte local en M\\u00e9xico y garant\\u00eda extendida.\\n            <\\\/div>\\n          <\\\/article>\\n\\n          <article class=\\\"rm-faq-item\\\">\\n            <button class=\\\"rm-faq-question\\\" type=\\\"button\\\">\\u00bfPuedo usar los monitores con estaci\\u00f3n de trabajo dual?<\\\/button>\\n            <div class=\\\"rm-faq-answer\\\">\\n              S\\u00ed. Nuestras soluciones incluyen configuraciones de estaci\\u00f3n dual y sencilla para teleradiolog\\u00eda e interpretaci\\u00f3n de estudios de medicina nuclear, seg\\u00fan las necesidades de su servicio.\\n            <\\\/div>\\n          <\\\/article>\\n\\n          <article class=\\\"rm-faq-item\\\">\\n            <button class=\\\"rm-faq-question\\\" type=\\\"button\\\">\\u00bfLos monitores cumplen con la normativa mexicana?<\\\/button>\\n            <div class=\\\"rm-faq-answer\\\">\\n              S\\u00ed. Los equipos cumplen con la NOM-241-SSA1-2021 y los est\\u00e1ndares de la COFEPRIS para dispositivos m\\u00e9dicos en M\\u00e9xico, necesarios para acreditaciones hospitalarias.\\n            <\\\/div>\\n          <\\\/article>\\n\\n          <article class=\\\"rm-faq-item\\\">\\n            <button class=\\\"rm-faq-question\\\" type=\\\"button\\\">\\u00bfSe pueden usar con el servicio de teleradiolog\\u00eda de Raditech?<\\\/button>\\n            <div class=\\\"rm-faq-answer\\\">\\n              S\\u00ed. Los monitores se integran directamente con el servicio de teleradiolog\\u00eda 24\\\/7 de Raditech, formando una soluci\\u00f3n completa para \\u00e1reas de imagen sin infraestructura propia.\\n            <\\\/div>\\n          <\\\/article>\\n        <\\\/div>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section class=\\\"rm-section rm-related\\\" id=\\\"servicios-relacionados\\\">\\n    <div class=\\\"rm-wrap\\\">\\n      <div class=\\\"rm-head\\\">\\n        <div>\\n          <span class=\\\"rm-eyebrow\\\">Servicios relacionados<\\\/span>\\n          <h2>Soluciones Raditech para imagen m\\u00e9dica.<\\\/h2>\\n        <\\\/div>\\n\\n        <p>\\n          Integra monitores m\\u00e9dicos, PACS-RIS, teleradiolog\\u00eda y entrega digital de estudios en un mismo ecosistema operativo.\\n        <\\\/p>\\n      <\\\/div>\\n\\n      <div class=\\\"rm-related-grid\\\">\\n        <a class=\\\"rm-related-card\\\" href=\\\"https:\\\/\\\/raditech.mx\\\/teleradiologia\\\/\\\">\\n          <div class=\\\"rm-related-icon\\\">\\ud83d\\udce1<\\\/div>\\n          <h3>Teleradiolog\\u00eda 24\\\/7<\\\/h3>\\n          <p>Interpretaci\\u00f3n remota DICOM con radi\\u00f3logos certificados. Urgencias en menos de 60 minutos.<\\\/p>\\n        <\\\/a>\\n\\n        <a class=\\\"rm-related-card\\\" href=\\\"https:\\\/\\\/raditech.mx\\\/pacs-ris\\\/\\\">\\n          <div class=\\\"rm-related-icon\\\">\\ud83d\\udda5\\ufe0f<\\\/div>\\n          <h3>Sistema PACS-RIS<\\\/h3>\\n          <p>Almacenamiento y gesti\\u00f3n de estudios con visor web avanzado y soporte 24\\\/7.<\\\/p>\\n        <\\\/a>\\n\\n        <a class=\\\"rm-related-card\\\" href=\\\"https:\\\/\\\/raditech.mx\\\/x-card\\\/\\\">\\n          <div class=\\\"rm-related-icon\\\">\\ud83e\\udeaa<\\\/div>\\n          <h3>Portal X-Card<\\\/h3>\\n          <p>Entrega digital de estudios al paciente v\\u00eda c\\u00f3digo QR. Sin placas ni CDs.<\\\/p>\\n        <\\\/a>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <a class=\\\"rm-sticky-whatsapp\\\" href=\\\"https:\\\/\\\/wa.me\\\/5215534449236\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\" aria-label=\\\"WhatsApp Raditech\\\">\\u260e<\\\/a>\\n\\n  <script>\\n    (function () {\\n      const root = document.querySelector(\\\".rm-page\\\");\\n      if (!root) return;\\n\\n      const faqItems = root.querySelectorAll(\\\".rm-faq-item\\\");\\n\\n      faqItems.forEach(function (item) {\\n        const button = item.querySelector(\\\".rm-faq-question\\\");\\n        if (!button) return;\\n\\n        button.addEventListener(\\\"click\\\", function () {\\n          const isActive = item.classList.contains(\\\"active\\\");\\n\\n          faqItems.forEach(function (faq) {\\n            faq.classList.remove(\\\"active\\\");\\n          });\\n\\n          if (!isActive) {\\n            item.classList.add(\\\"active\\\");\\n          }\\n        });\\n      });\\n\\n      const animated = root.querySelectorAll(\\\".rm-nav-box, .rm-info-card, .rm-panel-visual, .rm-feature-card, .rm-brand-card, .rm-guide-card, .rm-cta-box, .rm-faq-item, .rm-related-card\\\");\\n\\n      if (!(\\\"IntersectionObserver\\\" in window)) {\\n        animated.forEach(function (item) {\\n          item.style.opacity = \\\"1\\\";\\n          item.style.transform = \\\"translateY(0)\\\";\\n        });\\n        return;\\n      }\\n\\n      animated.forEach(function (item) {\\n        item.style.opacity = \\\"0\\\";\\n        item.style.transform = \\\"translateY(18px)\\\";\\n        item.style.transition = \\\"opacity .55s ease, transform .55s ease\\\";\\n      });\\n\\n      const observer = new IntersectionObserver(function (entries) {\\n        entries.forEach(function (entry) {\\n          if (entry.isIntersecting) {\\n            entry.target.style.opacity = \\\"1\\\";\\n            entry.target.style.transform = \\\"translateY(0)\\\";\\n            observer.unobserve(entry.target);\\n          }\\n        });\\n      }, { threshold: 0.12 });\\n\\n      animated.forEach(function (item) {\\n        observer.observe(item);\\n      });\\n    })();\\n  <\\\/script>\\n\\n  <script type=\\\"application\\\/ld+json\\\">\\n  {\\n    \\\"@context\\\": \\\"https:\\\/\\\/schema.org\\\",\\n    \\\"@type\\\": \\\"Service\\\",\\n    \\\"name\\\": \\\"Monitores M\\u00e9dicos para Radiolog\\u00eda\\\",\\n    \\\"description\\\": \\\"Monitores grado m\\u00e9dico para diagn\\u00f3stico radiol\\u00f3gico, interpretaci\\u00f3n DICOM, estaciones de trabajo para rayos X, TAC, resonancia magn\\u00e9tica y medicina nuclear.\\\",\\n    \\\"provider\\\": {\\n      \\\"@type\\\": \\\"Organization\\\",\\n      \\\"name\\\": \\\"Raditech\\\",\\n      \\\"url\\\": \\\"https:\\\/\\\/raditech.mx\\\/\\\"\\n    },\\n    \\\"areaServed\\\": {\\n      \\\"@type\\\": \\\"Country\\\",\\n      \\\"name\\\": \\\"M\\u00e9xico\\\"\\n    },\\n    \\\"serviceType\\\": \\\"Monitores grado m\\u00e9dico para radiolog\\u00eda\\\",\\n    \\\"availableChannel\\\": {\\n      \\\"@type\\\": \\\"ServiceChannel\\\",\\n      \\\"serviceUrl\\\": \\\"https:\\\/\\\/wa.me\\\/5215534449236\\\"\\n    }\\n  }\\n  <\\\/script>\\n<\\\/section>\\n```\\ngran directamente con el servicio de teleradiolog\\u00eda 24\\\/7 de Raditech para una soluci\\u00f3n completa de imagen m\\u00e9dica.\\\"}}]}<\\\/script><\\\/div>\\n<!-- \\\/wp:html -->\\n<p>&nbsp;<\\\/p>\"},\"elements\":[],\"widgetType\":\"text-editor\"}],\"isInner\":false}]"
