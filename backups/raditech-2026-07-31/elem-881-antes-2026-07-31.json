"[{\"id\":\"281093cd\",\"elType\":\"container\",\"settings\":[],\"elements\":[{\"id\":\"7c49f84d\",\"elType\":\"widget\",\"settings\":{\"editor\":\"```html\\n<section class=\\\"rt-pacs-page\\\">\\n  <style>\\n    .rt-pacs-page,\\n    .rt-pacs-page * {\\n      box-sizing: border-box;\\n    }\\n\\n    .rt-pacs-page {\\n      --rt-bg: #061423;\\n      --rt-bg-2: #0a1d31;\\n      --rt-bg-3: #102844;\\n      --rt-card: #0d2138;\\n      --rt-card-2: #132c48;\\n      --rt-white: #ffffff;\\n      --rt-text: #eaf1f8;\\n      --rt-muted: #b8c6d8;\\n      --rt-orange: #f09a37;\\n      --rt-orange-2: #ffb65c;\\n      --rt-orange-dark: #cf7f22;\\n      --rt-line: rgba(255, 255, 255, 0.09);\\n      --rt-shadow: 0 28px 80px rgba(0, 0, 0, 0.34);\\n      --rt-glow: 0 0 46px rgba(240, 154, 55, 0.18);\\n      position: relative;\\n      overflow-x: hidden;\\n      overflow-y: visible;\\n      color: var(--rt-text);\\n      background:\\n        radial-gradient(circle at 82% 12%, rgba(240, 154, 55, 0.13), transparent 26%),\\n        radial-gradient(circle at 14% 18%, rgba(255, 255, 255, 0.045), transparent 28%),\\n        linear-gradient(135deg, #04111d 0%, #07192b 48%, #091c2f 100%);\\n      font-family: inherit;\\n    }\\n\\n    .rt-pacs-page::before {\\n      content: \\\"\\\";\\n      position: fixed;\\n      inset: 0;\\n      z-index: 0;\\n      pointer-events: none;\\n      background:\\n        linear-gradient(rgba(255, 255, 255, 0.026) 1px, transparent 1px),\\n        linear-gradient(90deg, rgba(255, 255, 255, 0.026) 1px, transparent 1px);\\n      background-size: 42px 42px;\\n      mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.82), rgba(0, 0, 0, 0.12));\\n    }\\n\\n    .rt-pacs-page > * {\\n      position: relative;\\n      z-index: 1;\\n    }\\n\\n    .rt-pacs-page a {\\n      color: inherit;\\n      text-decoration: none;\\n    }\\n\\n    .rtp-wrap {\\n      width: min(1180px, calc(100% - 32px));\\n      margin: 0 auto;\\n    }\\n\\n    .rtp-eyebrow {\\n      display: inline-flex;\\n      align-items: center;\\n      gap: 10px;\\n      padding: 8px 14px;\\n      border-radius: 999px;\\n      border: 1px solid rgba(240, 154, 55, 0.28);\\n      background: rgba(240, 154, 55, 0.12);\\n      color: var(--rt-orange-2);\\n      font-size: 13px;\\n      font-weight: 900;\\n      letter-spacing: 0.05em;\\n      text-transform: uppercase;\\n    }\\n\\n    .rtp-eyebrow::before {\\n      content: \\\"\\\";\\n      width: 8px;\\n      height: 8px;\\n      border-radius: 999px;\\n      background: var(--rt-orange);\\n      box-shadow: 0 0 18px rgba(240, 154, 55, 0.9);\\n      flex: 0 0 auto;\\n    }\\n\\n    .rtp-btn {\\n      position: relative;\\n      display: inline-flex;\\n      align-items: center;\\n      justify-content: center;\\n      gap: 10px;\\n      min-height: 52px;\\n      padding: 15px 22px;\\n      border-radius: 999px;\\n      font-weight: 900;\\n      overflow: hidden;\\n      text-align: center;\\n      transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease, border-color 0.25s ease;\\n    }\\n\\n    .rtp-btn::after {\\n      content: \\\"\\\";\\n      position: absolute;\\n      inset: 0;\\n      background: linear-gradient(100deg, transparent 0%, rgba(255, 255, 255, 0.28) 45%, transparent 70%);\\n      transform: translateX(-120%);\\n      transition: transform 0.7s ease;\\n      pointer-events: none;\\n    }\\n\\n    .rtp-btn:hover::after {\\n      transform: translateX(120%);\\n    }\\n\\n    .rtp-btn:hover {\\n      transform: translateY(-3px);\\n    }\\n\\n    .rtp-btn.primary {\\n      color: #071423;\\n      background: linear-gradient(135deg, var(--rt-orange), var(--rt-orange-2));\\n      box-shadow: 0 16px 42px rgba(240, 154, 55, 0.26);\\n    }\\n\\n    .rtp-btn.secondary {\\n      color: var(--rt-white);\\n      border: 1px solid rgba(255, 255, 255, 0.16);\\n      background: rgba(255, 255, 255, 0.06);\\n      backdrop-filter: blur(14px);\\n    }\\n\\n    .rtp-hero {\\n      position: relative;\\n      min-height: 720px;\\n      padding: 76px 0 88px;\\n      overflow: hidden;\\n      isolation: isolate;\\n      background:\\n        radial-gradient(circle at 84% 16%, rgba(240, 154, 55, 0.18), transparent 24%),\\n        radial-gradient(circle at 16% 22%, rgba(255, 255, 255, 0.055), transparent 28%),\\n        linear-gradient(135deg, #04111d 0%, #07192b 58%, #091c2f 100%);\\n    }\\n\\n    .rtp-hero::before {\\n      content: \\\"\\\";\\n      position: absolute;\\n      inset: 0;\\n      background:\\n        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),\\n        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);\\n      background-size: 42px 42px;\\n      mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.72), transparent);\\n      z-index: -2;\\n    }\\n\\n    .rtp-hero::after {\\n      content: \\\"\\\";\\n      position: absolute;\\n      inset: auto -10% -26% -10%;\\n      height: 360px;\\n      background: radial-gradient(ellipse at center, rgba(240, 154, 55, 0.13), transparent 64%);\\n      z-index: -1;\\n      pointer-events: none;\\n    }\\n\\n    .rtp-hero-grid {\\n      display: grid;\\n      grid-template-columns: 0.98fr 1.02fr;\\n      gap: 54px;\\n      align-items: center;\\n    }\\n\\n    .rtp-brand {\\n      width: 220px;\\n      max-width: 70%;\\n      margin-bottom: 28px;\\n      padding: 14px 18px;\\n      border-radius: 22px;\\n      background: rgba(255, 255, 255, 0.04);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      backdrop-filter: blur(12px);\\n      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.24);\\n    }\\n\\n    .rtp-brand img {\\n      display: block;\\n      width: 100%;\\n      height: auto;\\n    }\\n\\n    .rtp-hero h1 {\\n      margin: 20px 0 18px;\\n      max-width: 760px;\\n      font-size: clamp(46px, 7vw, 92px);\\n      line-height: 0.92;\\n      letter-spacing: -0.07em;\\n      font-weight: 950;\\n      color: var(--rt-white);\\n    }\\n\\n    .rtp-hero h1 span {\\n      display: block;\\n      background: linear-gradient(90deg, var(--rt-orange), var(--rt-orange-2), #ffffff);\\n      -webkit-background-clip: text;\\n      background-clip: text;\\n      color: transparent;\\n    }\\n\\n    .rtp-hero p {\\n      margin: 0;\\n      max-width: 660px;\\n      color: rgba(255, 255, 255, 0.82);\\n      font-size: clamp(18px, 2vw, 22px);\\n      line-height: 1.62;\\n    }\\n\\n    .rtp-actions {\\n      display: flex;\\n      flex-wrap: wrap;\\n      gap: 14px;\\n      margin-top: 30px;\\n    }\\n\\n    .rtp-hero-media {\\n      position: relative;\\n      min-height: 520px;\\n      display: grid;\\n      place-items: center;\\n      perspective: 1000px;\\n    }\\n\\n    .rtp-orbit {\\n      position: absolute;\\n      width: 420px;\\n      height: 420px;\\n      right: -26px;\\n      top: -8px;\\n      border-radius: 999px;\\n      border: 1px solid rgba(240, 154, 55, 0.16);\\n      animation: rtpSpin 18s linear infinite;\\n      pointer-events: none;\\n      opacity: 0.75;\\n    }\\n\\n    .rtp-orbit::before,\\n    .rtp-orbit::after {\\n      content: \\\"\\\";\\n      position: absolute;\\n      border-radius: 999px;\\n      background: var(--rt-orange);\\n      box-shadow: 0 0 24px rgba(240, 154, 55, 0.75);\\n    }\\n\\n    .rtp-orbit::before {\\n      width: 10px;\\n      height: 10px;\\n      top: 36px;\\n      left: 62px;\\n    }\\n\\n    .rtp-orbit::after {\\n      width: 7px;\\n      height: 7px;\\n      right: 56px;\\n      bottom: 74px;\\n    }\\n\\n    .rtp-screen {\\n      position: relative;\\n      width: 100%;\\n      border-radius: 36px;\\n      overflow: hidden;\\n      background: rgba(255, 255, 255, 0.03);\\n      border: 1px solid rgba(255, 255, 255, 0.1);\\n      box-shadow: 0 30px 90px rgba(0, 0, 0, 0.42), var(--rt-glow);\\n      animation: rtpFloat 6s ease-in-out infinite;\\n    }\\n\\n    .rtp-screen::before {\\n      content: \\\"\\\";\\n      position: absolute;\\n      inset: 0;\\n      background: linear-gradient(120deg, rgba(240, 154, 55, 0.14), transparent 38%, rgba(255, 255, 255, 0.05));\\n      z-index: 1;\\n      pointer-events: none;\\n    }\\n\\n    .rtp-screen img {\\n      display: block;\\n      width: 100%;\\n      height: auto;\\n    }\\n\\n    .rtp-floating {\\n      position: absolute;\\n      left: -18px;\\n      bottom: 8px;\\n      width: min(360px, 76%);\\n      padding: 22px;\\n      border-radius: 26px;\\n      background: linear-gradient(180deg, #102844 0%, #0b2036 100%);\\n      color: var(--rt-text);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      box-shadow: var(--rt-shadow);\\n      animation: rtpFloatSmall 5s ease-in-out infinite;\\n    }\\n\\n    .rtp-floating strong {\\n      display: block;\\n      font-size: 38px;\\n      line-height: 1;\\n      color: var(--rt-orange);\\n      letter-spacing: -0.04em;\\n    }\\n\\n    .rtp-floating span {\\n      display: block;\\n      margin-top: 6px;\\n      color: var(--rt-muted);\\n      font-weight: 700;\\n      line-height: 1.5;\\n    }\\n\\n    .rtp-quick {\\n      margin-top: -52px;\\n      position: relative;\\n      z-index: 5;\\n    }\\n\\n    .rtp-quick-box {\\n      display: grid;\\n      grid-template-columns: 0.78fr 1.22fr;\\n      gap: 1px;\\n      border-radius: 30px;\\n      overflow: hidden;\\n      background: rgba(255, 255, 255, 0.08);\\n      box-shadow: var(--rt-shadow);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n    }\\n\\n    .rtp-quick-main {\\n      padding: 26px;\\n      background: linear-gradient(180deg, #132c48 0%, #0d2138 100%);\\n    }\\n\\n    .rtp-quick-main strong {\\n      display: block;\\n      color: var(--rt-white);\\n      font-size: 26px;\\n      letter-spacing: -0.03em;\\n      line-height: 1.1;\\n    }\\n\\n    .rtp-quick-main span {\\n      display: block;\\n      margin-top: 8px;\\n      color: var(--rt-muted);\\n      line-height: 1.55;\\n    }\\n\\n    .rtp-quick-links {\\n      display: grid;\\n      grid-template-columns: repeat(4, 1fr);\\n      gap: 1px;\\n      background: rgba(255, 255, 255, 0.08);\\n    }\\n\\n    .rtp-quick-links a {\\n      min-height: 130px;\\n      display: flex;\\n      flex-direction: column;\\n      justify-content: space-between;\\n      padding: 22px;\\n      background: linear-gradient(180deg, #10243b 0%, #0b1d30 100%);\\n      transition: background 0.25s ease, transform 0.25s ease;\\n    }\\n\\n    .rtp-quick-links a:hover {\\n      background: linear-gradient(180deg, #173555 0%, #102844 100%);\\n    }\\n\\n    .rtp-quick-links b {\\n      color: var(--rt-white);\\n      font-size: 18px;\\n      letter-spacing: -0.02em;\\n    }\\n\\n    .rtp-quick-links small {\\n      color: var(--rt-orange-2);\\n      font-weight: 900;\\n    }\\n\\n    .rtp-stats {\\n      padding: 34px 0 0;\\n    }\\n\\n    .rtp-stats-grid {\\n      display: grid;\\n      grid-template-columns: repeat(4, 1fr);\\n      gap: 12px;\\n    }\\n\\n    .rtp-stat {\\n      padding: 24px 18px;\\n      border-radius: 24px;\\n      background: linear-gradient(180deg, #10243b 0%, #0b1d30 100%);\\n      text-align: center;\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      box-shadow: 0 16px 42px rgba(0, 0, 0, 0.16);\\n    }\\n\\n    .rtp-stat strong {\\n      display: block;\\n      font-size: clamp(28px, 3.6vw, 44px);\\n      line-height: 1;\\n      color: var(--rt-orange);\\n      letter-spacing: -0.04em;\\n    }\\n\\n    .rtp-stat span {\\n      display: block;\\n      margin-top: 10px;\\n      color: var(--rt-muted);\\n      font-weight: 800;\\n      font-size: 13px;\\n      text-transform: uppercase;\\n      letter-spacing: 0.04em;\\n    }\\n\\n    .rtp-section {\\n      padding: 76px 0;\\n    }\\n\\n    .rtp-section.soft {\\n      background:\\n        radial-gradient(circle at 15% 20%, rgba(240, 154, 55, 0.09), transparent 30%),\\n        linear-gradient(180deg, var(--rt-bg-2) 0%, var(--rt-bg) 100%);\\n    }\\n\\n    .rtp-head {\\n      display: grid;\\n      grid-template-columns: 0.8fr 1.2fr;\\n      gap: 34px;\\n      align-items: end;\\n      margin-bottom: 34px;\\n    }\\n\\n    .rtp-head h2 {\\n      margin: 16px 0 0;\\n      color: var(--rt-white);\\n      font-size: clamp(34px, 4.5vw, 58px);\\n      line-height: 1;\\n      letter-spacing: -0.05em;\\n      font-weight: 950;\\n    }\\n\\n    .rtp-head p {\\n      margin: 0;\\n      color: #c9d6e6;\\n      font-size: 18px;\\n      line-height: 1.68;\\n    }\\n\\n    .rtp-software {\\n      display: grid;\\n      grid-template-columns: 1fr 1fr;\\n      gap: 24px;\\n      align-items: stretch;\\n    }\\n\\n    .rtp-panel {\\n      padding: clamp(28px, 4.5vw, 52px);\\n      border-radius: 34px;\\n      background: linear-gradient(180deg, var(--rt-card-2) 0%, var(--rt-card) 100%);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      box-shadow: 0 18px 55px rgba(0, 0, 0, 0.22);\\n    }\\n\\n    .rtp-panel h2,\\n    .rtp-panel h3 {\\n      margin: 0 0 16px;\\n      color: var(--rt-white);\\n      font-size: clamp(34px, 4vw, 54px);\\n      line-height: 1;\\n      letter-spacing: -0.05em;\\n      font-weight: 950;\\n    }\\n\\n    .rtp-panel p {\\n      margin: 0;\\n      color: var(--rt-muted);\\n      font-size: 18px;\\n      line-height: 1.72;\\n    }\\n\\n    .rtp-panel p + p {\\n      margin-top: 14px;\\n    }\\n\\n    .rtp-media-card {\\n      position: relative;\\n      min-height: 440px;\\n      border-radius: 34px;\\n      overflow: hidden;\\n      background: #081522;\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      box-shadow: var(--rt-shadow);\\n    }\\n\\n    .rtp-media-card img {\\n      width: 100%;\\n      height: 100%;\\n      object-fit: cover;\\n      display: block;\\n      transform: scale(1.02);\\n    }\\n\\n    .rtp-media-card::after {\\n      content: \\\"\\\";\\n      position: absolute;\\n      inset: 0;\\n      background:\\n        linear-gradient(120deg, rgba(240, 154, 55, 0.12), transparent 40%),\\n        linear-gradient(to top, rgba(4, 17, 29, 0.72), transparent 52%);\\n      pointer-events: none;\\n    }\\n\\n    .rtp-features-grid {\\n      display: grid;\\n      grid-template-columns: repeat(5, 1fr);\\n      gap: 14px;\\n    }\\n\\n    .rtp-feature {\\n      position: relative;\\n      min-height: 250px;\\n      padding: 26px;\\n      border-radius: 28px;\\n      background: linear-gradient(180deg, #10243b 0%, #0b1d30 100%);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      box-shadow: 0 16px 45px rgba(0, 0, 0, 0.18);\\n      overflow: hidden;\\n      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;\\n    }\\n\\n    .rtp-feature::before {\\n      content: \\\"\\\";\\n      position: absolute;\\n      inset: -1px;\\n      background: linear-gradient(135deg, rgba(240, 154, 55, 0.18), transparent 44%);\\n      opacity: 0;\\n      transition: opacity 0.25s ease;\\n      pointer-events: none;\\n    }\\n\\n    .rtp-feature:hover {\\n      transform: translateY(-5px);\\n      border-color: rgba(240, 154, 55, 0.28);\\n      box-shadow: 0 24px 62px rgba(0, 0, 0, 0.28);\\n    }\\n\\n    .rtp-feature:hover::before {\\n      opacity: 1;\\n    }\\n\\n    .rtp-icon {\\n      position: relative;\\n      z-index: 1;\\n      width: 48px;\\n      height: 48px;\\n      margin-bottom: 18px;\\n      border-radius: 16px;\\n      display: grid;\\n      place-items: center;\\n      background: linear-gradient(135deg, var(--rt-orange), var(--rt-orange-2));\\n      color: #071423;\\n      font-size: 22px;\\n      font-weight: 950;\\n      box-shadow: 0 16px 34px rgba(240, 154, 55, 0.22);\\n    }\\n\\n    .rtp-feature h3 {\\n      position: relative;\\n      z-index: 1;\\n      margin: 0 0 10px;\\n      color: #ffffff;\\n      font-size: 22px;\\n      line-height: 1.08;\\n      letter-spacing: -0.035em;\\n      font-weight: 950;\\n    }\\n\\n    .rtp-feature p {\\n      position: relative;\\n      z-index: 1;\\n      margin: 0;\\n      color: #c9d6e6;\\n      line-height: 1.62;\\n      font-weight: 650;\\n    }\\n\\n    .rtp-tabs-shell {\\n      display: grid;\\n      grid-template-columns: 330px 1fr;\\n      gap: 22px;\\n      align-items: stretch;\\n    }\\n\\n    .rtp-tabs-nav {\\n      display: grid;\\n      gap: 14px;\\n      align-content: start;\\n    }\\n\\n    .rtp-tab-btn {\\n      width: 100%;\\n      border: 1px solid rgba(255, 255, 255, 0.11) !important;\\n      border-radius: 22px;\\n      padding: 18px;\\n      cursor: pointer;\\n      text-align: left;\\n      background: linear-gradient(180deg, #10243b 0%, #0b1d30 100%) !important;\\n      color: #ffffff !important;\\n      font-family: inherit;\\n      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.22) !important;\\n      transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;\\n    }\\n\\n    .rtp-tab-btn:hover {\\n      transform: translateX(6px);\\n      border-color: rgba(240, 154, 55, 0.36) !important;\\n      background: linear-gradient(180deg, #173555 0%, #102844 100%) !important;\\n    }\\n\\n    .rtp-tab-btn.active {\\n      transform: translateX(6px);\\n      border-color: rgba(255, 182, 92, 0.8) !important;\\n      background: linear-gradient(135deg, #f09a37 0%, #ffb65c 100%) !important;\\n      color: #071423 !important;\\n      box-shadow: 0 18px 42px rgba(240, 154, 55, 0.28) !important;\\n    }\\n\\n    .rtp-tab-btn strong {\\n      display: block;\\n      color: #ffffff !important;\\n      font-size: 20px;\\n      line-height: 1.1;\\n      letter-spacing: -0.03em;\\n      font-weight: 950 !important;\\n    }\\n\\n    .rtp-tab-btn span {\\n      display: block;\\n      color: #b8c6d8 !important;\\n      margin-top: 6px;\\n      font-size: 14px;\\n      line-height: 1.45;\\n      font-weight: 700 !important;\\n    }\\n\\n    .rtp-tab-btn.active strong,\\n    .rtp-tab-btn.active span {\\n      color: #071423 !important;\\n    }\\n\\n    .rtp-tab-panel {\\n      display: none;\\n      min-height: 520px;\\n      overflow: hidden;\\n      border-radius: 34px;\\n      background: linear-gradient(180deg, var(--rt-card-2) 0%, var(--rt-card) 100%);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      box-shadow: var(--rt-shadow);\\n    }\\n\\n    .rtp-tab-panel.active {\\n      display: grid;\\n      grid-template-columns: 1fr 1fr;\\n      animation: rtpFade 0.45s ease both;\\n    }\\n\\n    .rtp-tab-media {\\n      min-height: 520px;\\n      background: #081522;\\n      overflow: hidden;\\n    }\\n\\n    .rtp-tab-media img {\\n      width: 100%;\\n      height: 100%;\\n      object-fit: cover;\\n      display: block;\\n      transform: scale(1.02);\\n    }\\n\\n    .rtp-tab-content {\\n      padding: clamp(30px, 5vw, 52px);\\n      display: flex;\\n      flex-direction: column;\\n      justify-content: center;\\n    }\\n\\n    .rtp-tab-content h3 {\\n      margin: 0 0 14px;\\n      color: #ffffff !important;\\n      font-size: clamp(32px, 4vw, 52px);\\n      line-height: 1;\\n      letter-spacing: -0.05em;\\n      font-weight: 950;\\n      text-shadow: 0 2px 18px rgba(0, 0, 0, 0.28);\\n    }\\n\\n    .rtp-tab-content p {\\n      margin: 0;\\n      color: #c9d6e6 !important;\\n      font-size: 18px;\\n      line-height: 1.7;\\n    }\\n\\n    .rtp-checks {\\n      display: grid;\\n      grid-template-columns: repeat(2, minmax(0, 1fr));\\n      gap: 12px;\\n      margin: 24px 0 0;\\n      padding: 0;\\n      list-style: none;\\n    }\\n\\n    .rtp-checks li {\\n      position: relative;\\n      padding: 14px 16px 14px 48px;\\n      border-radius: 18px;\\n      background: rgba(255, 255, 255, 0.065) !important;\\n      color: #f4f8fc !important;\\n      font-weight: 800 !important;\\n      border: 1px solid rgba(255, 255, 255, 0.09) !important;\\n      word-break: normal !important;\\n      overflow-wrap: normal !important;\\n      hyphens: none !important;\\n      line-height: 1.45;\\n    }\\n\\n    .rtp-checks li::before {\\n      content: \\\"\\u2713\\\";\\n      position: absolute;\\n      left: 16px;\\n      top: 13px;\\n      width: 24px;\\n      height: 24px;\\n      border-radius: 50%;\\n      display: grid;\\n      place-items: center;\\n      background: linear-gradient(135deg, #f09a37, #ffb65c) !important;\\n      color: #071423 !important;\\n      font-size: 14px;\\n      font-weight: 950;\\n    }\\n\\n    .rtp-audience-grid {\\n      display: grid;\\n      grid-template-columns: repeat(4, 1fr);\\n      gap: 18px;\\n    }\\n\\n    .rtp-audience {\\n      position: relative;\\n      min-height: 250px;\\n      padding: 28px;\\n      border-radius: 30px;\\n      background: rgba(255, 255, 255, 0.05);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      backdrop-filter: blur(14px);\\n      overflow: hidden;\\n      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;\\n    }\\n\\n    .rtp-audience::before {\\n      content: \\\"\\\";\\n      position: absolute;\\n      inset: -1px;\\n      background: linear-gradient(135deg, rgba(240, 154, 55, 0.18), transparent 42%);\\n      opacity: 0;\\n      transition: opacity 0.25s ease;\\n      pointer-events: none;\\n    }\\n\\n    .rtp-audience:hover {\\n      transform: translateY(-5px);\\n      border-color: rgba(240, 154, 55, 0.26);\\n      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.22);\\n    }\\n\\n    .rtp-audience:hover::before {\\n      opacity: 1;\\n    }\\n\\n    .rtp-audience h3,\\n    .rtp-audience p,\\n    .rtp-audience .rtp-icon {\\n      position: relative;\\n      z-index: 1;\\n    }\\n\\n    .rtp-audience h3 {\\n      margin: 0 0 12px;\\n      color: #ffffff;\\n      font-size: 25px;\\n      line-height: 1.12;\\n      letter-spacing: -0.035em;\\n      font-weight: 950;\\n    }\\n\\n    .rtp-audience p {\\n      margin: 0;\\n      color: rgba(255, 255, 255, 0.78);\\n      line-height: 1.65;\\n      font-weight: 650;\\n    }\\n\\n    .rtp-study {\\n      display: grid;\\n      grid-template-columns: 0.95fr 1.05fr;\\n      gap: 24px;\\n      align-items: stretch;\\n    }\\n\\n    .rtp-study-card {\\n      padding: clamp(28px, 4.5vw, 52px);\\n      border-radius: 34px;\\n      background: linear-gradient(180deg, var(--rt-card-2) 0%, var(--rt-card) 100%);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      box-shadow: 0 18px 55px rgba(0, 0, 0, 0.22);\\n    }\\n\\n    .rtp-study-card h2 {\\n      margin: 14px 0 16px;\\n      color: #ffffff;\\n      font-size: clamp(34px, 4.5vw, 58px);\\n      line-height: 1;\\n      letter-spacing: -0.05em;\\n      font-weight: 950;\\n    }\\n\\n    .rtp-study-card p {\\n      margin: 0;\\n      color: var(--rt-muted);\\n      font-size: 18px;\\n      line-height: 1.7;\\n    }\\n\\n    .rtp-study-card .rtp-actions {\\n      margin-top: 26px;\\n    }\\n\\n    .rtp-cost {\\n      padding: 76px 0;\\n      background:\\n        radial-gradient(circle at 20% 20%, rgba(240, 154, 55, 0.17), transparent 26%),\\n        linear-gradient(135deg, #04111d 0%, #091d31 100%);\\n    }\\n\\n    .rtp-cost-box {\\n      display: grid;\\n      grid-template-columns: 1fr auto;\\n      gap: 32px;\\n      align-items: center;\\n      padding: clamp(30px, 5vw, 56px);\\n      border-radius: 36px;\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      background: rgba(255, 255, 255, 0.05);\\n      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22);\\n      backdrop-filter: blur(12px);\\n    }\\n\\n    .rtp-cost h2 {\\n      margin: 0 0 14px;\\n      font-size: clamp(34px, 4.5vw, 60px);\\n      line-height: 1;\\n      letter-spacing: -0.05em;\\n      font-weight: 950;\\n      color: var(--rt-white);\\n    }\\n\\n    .rtp-cost p {\\n      margin: 0;\\n      color: rgba(255, 255, 255, 0.78);\\n      font-size: 18px;\\n      line-height: 1.7;\\n    }\\n\\n    .rtp-related {\\n      padding: 80px 0;\\n      background: #061423;\\n    }\\n\\n    .rtp-related-grid {\\n      display: grid;\\n      grid-template-columns: repeat(3, 1fr);\\n      gap: 24px;\\n    }\\n\\n    .rtp-related-card {\\n      padding: 28px;\\n      border-radius: 28px;\\n      background: linear-gradient(180deg, #10243b 0%, #0b1d30 100%);\\n      border: 1px solid rgba(255, 255, 255, 0.08);\\n      box-shadow: 0 16px 45px rgba(0, 0, 0, 0.18);\\n      transition: transform 0.25s ease, border-color 0.25s ease;\\n    }\\n\\n    .rtp-related-card:hover {\\n      transform: translateY(-5px);\\n      border-color: rgba(240, 154, 55, 0.28);\\n    }\\n\\n    .rtp-related-card .rtp-related-icon {\\n      font-size: 1.8rem;\\n      margin-bottom: 12px;\\n    }\\n\\n    .rtp-related-card h3 {\\n      font-size: 1.05rem;\\n      font-weight: 900;\\n      margin-bottom: 8px;\\n      color: #ffffff;\\n    }\\n\\n    .rtp-related-card p {\\n      color: #b8c6d8;\\n      font-size: 0.9rem;\\n      line-height: 1.6;\\n      margin: 0;\\n    }\\n\\n    @keyframes rtpFloat {\\n      0%, 100% {\\n        transform: rotate(1deg) translateY(0);\\n      }\\n\\n      50% {\\n        transform: rotate(1deg) translateY(-14px);\\n      }\\n    }\\n\\n    @keyframes rtpFloatSmall {\\n      0%, 100% {\\n        transform: translateY(0);\\n      }\\n\\n      50% {\\n        transform: translateY(-8px);\\n      }\\n    }\\n\\n    @keyframes rtpSpin {\\n      to {\\n        transform: rotate(360deg);\\n      }\\n    }\\n\\n    @keyframes rtpFade {\\n      from {\\n        opacity: 0;\\n        transform: translateY(12px);\\n      }\\n\\n      to {\\n        opacity: 1;\\n        transform: translateY(0);\\n      }\\n    }\\n\\n    @media (max-width: 1180px) {\\n      .rtp-features-grid {\\n        grid-template-columns: repeat(2, 1fr);\\n      }\\n\\n      .rtp-checks {\\n        grid-template-columns: 1fr !important;\\n      }\\n    }\\n\\n    @media (max-width: 980px) {\\n      .rtp-hero {\\n        min-height: auto;\\n        padding: 54px 0 90px;\\n      }\\n\\n      .rtp-hero-grid,\\n      .rtp-quick-box,\\n      .rtp-head,\\n      .rtp-software,\\n      .rtp-tabs-shell,\\n      .rtp-tab-panel.active,\\n      .rtp-study,\\n      .rtp-cost-box {\\n        grid-template-columns: 1fr;\\n      }\\n\\n      .rtp-hero-media {\\n        min-height: auto;\\n      }\\n\\n      .rtp-quick-links {\\n        grid-template-columns: repeat(2, 1fr);\\n      }\\n\\n      .rtp-stats-grid,\\n      .rtp-audience-grid,\\n      .rtp-related-grid {\\n        grid-template-columns: repeat(2, 1fr);\\n      }\\n\\n      .rtp-tab-media {\\n        min-height: 300px;\\n      }\\n\\n      .rtp-media-card {\\n        min-height: 320px;\\n      }\\n    }\\n\\n    @media (max-width: 620px) {\\n      .rtp-wrap {\\n        width: min(100% - 22px, 1180px);\\n      }\\n\\n      .rtp-hero {\\n        padding-top: 36px;\\n      }\\n\\n      .rtp-brand {\\n        width: 178px;\\n        margin-bottom: 24px;\\n      }\\n\\n      .rtp-actions {\\n        flex-direction: column;\\n      }\\n\\n      .rtp-btn {\\n        width: 100%;\\n      }\\n\\n      .rtp-floating {\\n        position: relative;\\n        left: auto;\\n        bottom: auto;\\n        width: 100%;\\n        margin-top: 16px;\\n      }\\n\\n      .rtp-quick {\\n        margin-top: -36px;\\n      }\\n\\n      .rtp-quick-links,\\n      .rtp-stats-grid,\\n      .rtp-features-grid,\\n      .rtp-audience-grid,\\n      .rtp-checks,\\n      .rtp-related-grid {\\n        grid-template-columns: 1fr;\\n      }\\n\\n      .rtp-section,\\n      .rtp-cost,\\n      .rtp-related {\\n        padding: 58px 0;\\n      }\\n\\n      .rtp-tab-content,\\n      .rtp-panel,\\n      .rtp-study-card,\\n      .rtp-audience,\\n      .rtp-feature,\\n      .rtp-related-card {\\n        padding: 24px;\\n      }\\n\\n      .rtp-tab-btn {\\n        border-radius: 20px !important;\\n        padding: 17px 18px !important;\\n      }\\n\\n      .rtp-tab-btn:hover,\\n      .rtp-tab-btn.active {\\n        transform: none !important;\\n      }\\n\\n      .rtp-tab-content h3 {\\n        font-size: 38px !important;\\n      }\\n    }\\n  <\\\/style>\\n\\n  <section id=\\\"inicio-pacs\\\" class=\\\"rtp-hero\\\">\\n    <div class=\\\"rtp-wrap\\\">\\n      <div class=\\\"rtp-hero-grid\\\">\\n        <div>\\n          <div class=\\\"rtp-brand\\\">\\n            <img src=\\\"https:\\\/\\\/raditech.mx\\\/wp-content\\\/uploads\\\/2024\\\/11\\\/raditech-logo-nombre.svg\\\" alt=\\\"Raditech\\\">\\n          <\\\/div>\\n\\n          <span class=\\\"rtp-eyebrow\\\">PACS \\u00b7 RIS \\u00b7 Radiolog\\u00eda digital<\\\/span>\\n\\n          <h1>\\n            PACS-RIS para \\u00e1reas de radiolog\\u00eda.\\n          <\\\/h1>\\n\\n          <p>\\n            Sistema operativo avanzado para optimizar almacenamiento, visualizaci\\u00f3n, distribuci\\u00f3n, control de tiempos y gesti\\u00f3n de estudios radiol\\u00f3gicos.\\n          <\\\/p>\\n\\n          <div class=\\\"rtp-actions\\\">\\n            <a class=\\\"rtp-btn primary\\\" href=\\\"https:\\\/\\\/wa.me\\\/5215534449236\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Habla con un especialista<\\\/a>\\n            <a class=\\\"rtp-btn secondary\\\" href=\\\"#caracteristicas-pacs\\\">Ver caracter\\u00edsticas<\\\/a>\\n          <\\\/div>\\n        <\\\/div>\\n\\n        <div class=\\\"rtp-hero-media\\\">\\n          <div class=\\\"rtp-orbit\\\"><\\\/div>\\n\\n          <div class=\\\"rtp-screen\\\">\\n            <img src=\\\"https:\\\/\\\/raditech.mx\\\/wp-content\\\/uploads\\\/2024\\\/11\\\/15_xovsdg-2.png\\\" alt=\\\"PACS RIS Raditech\\\">\\n          <\\\/div>\\n\\n          <div class=\\\"rtp-floating\\\">\\n            <strong>24\\\/7<\\\/strong>\\n            <span>Soporte remoto, operaci\\u00f3n continua y mantenimiento durante todo el a\\u00f1o.<\\\/span>\\n          <\\\/div>\\n        <\\\/div>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section class=\\\"rtp-quick\\\">\\n    <div class=\\\"rtp-wrap\\\">\\n      <div class=\\\"rtp-quick-box\\\">\\n        <div class=\\\"rtp-quick-main\\\">\\n          <strong>PACS-RIS en una sola plataforma.<\\\/strong>\\n          <span>Menos fricci\\u00f3n operativa para radi\\u00f3logos, m\\u00e9dicos tratantes, pacientes, jefaturas, biom\\u00e9dica y sistemas.<\\\/span>\\n        <\\\/div>\\n\\n        <div class=\\\"rtp-quick-links\\\">\\n          <a href=\\\"#software-pacs\\\">\\n            <b>Software<\\\/b>\\n            <small>Conocer \\u2192<\\\/small>\\n          <\\\/a>\\n\\n          <a href=\\\"#caracteristicas-pacs\\\">\\n            <b>Caracter\\u00edsticas<\\\/b>\\n            <small>Explorar \\u2192<\\\/small>\\n          <\\\/a>\\n\\n          <a href=\\\"#beneficios-pacs\\\">\\n            <b>Beneficios<\\\/b>\\n            <small>Ver \\u00e1reas \\u2192<\\\/small>\\n          <\\\/a>\\n\\n          <a href=\\\"#cotizar-pacs\\\">\\n            <b>Cotizar<\\\/b>\\n            <small>Contacto \\u2192<\\\/small>\\n          <\\\/a>\\n        <\\\/div>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section class=\\\"rtp-stats\\\">\\n    <div class=\\\"rtp-wrap\\\">\\n      <div class=\\\"rtp-stats-grid\\\">\\n        <div class=\\\"rtp-stat\\\">\\n          <strong>Web<\\\/strong>\\n          <span>Base flexible<\\\/span>\\n        <\\\/div>\\n\\n        <div class=\\\"rtp-stat\\\">\\n          <strong>24\\\/7<\\\/strong>\\n          <span>Soporte remoto<\\\/span>\\n        <\\\/div>\\n\\n        <div class=\\\"rtp-stat\\\">\\n          <strong>365<\\\/strong>\\n          <span>D\\u00edas al a\\u00f1o<\\\/span>\\n        <\\\/div>\\n\\n        <div class=\\\"rtp-stat\\\">\\n          <strong>\\u221e<\\\/strong>\\n          <span>Almacenamiento<\\\/span>\\n        <\\\/div>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section id=\\\"software-pacs\\\" class=\\\"rtp-section\\\">\\n    <div class=\\\"rtp-wrap\\\">\\n      <div class=\\\"rtp-software\\\">\\n        <div class=\\\"rtp-panel\\\">\\n          <span class=\\\"rtp-eyebrow\\\">Nuestro software<\\\/span>\\n\\n          <h2>Almacenamiento y gesti\\u00f3n de estudios con visi\\u00f3n hospitalaria.<\\\/h2>\\n\\n          <p>\\n            PACS-RIS Raditech es una soluci\\u00f3n confiable para almacenamiento, gesti\\u00f3n, visualizaci\\u00f3n y distribuci\\u00f3n de estudios dentro del \\u00e1rea de radiolog\\u00eda.\\n          <\\\/p>\\n\\n          <p>\\n            Su arquitectura permite flexibilidad tecnol\\u00f3gica, adaptaci\\u00f3n al flujo de trabajo de cada sede y acceso web para m\\u00e9dicos tratantes y usuarios autorizados.\\n          <\\\/p>\\n\\n          <div class=\\\"rtp-actions\\\">\\n            <a class=\\\"rtp-btn primary\\\" href=\\\"https:\\\/\\\/wa.me\\\/5215534449236\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Solicitar informaci\\u00f3n<\\\/a>\\n            <a class=\\\"rtp-btn secondary\\\" href=\\\"#innovacion-pacs\\\">Ver innovaci\\u00f3n<\\\/a>\\n          <\\\/div>\\n        <\\\/div>\\n\\n        <div class=\\\"rtp-media-card\\\">\\n          <img src=\\\"https:\\\/\\\/raditech.mx\\\/wp-content\\\/uploads\\\/2024\\\/11\\\/pacs-raditech-interfaz.svg\\\" alt=\\\"Interfaz PACS Raditech\\\">\\n        <\\\/div>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section id=\\\"caracteristicas-pacs\\\" class=\\\"rtp-section soft\\\">\\n    <div class=\\\"rtp-wrap\\\">\\n      <div class=\\\"rtp-head\\\">\\n        <div>\\n          <span class=\\\"rtp-eyebrow\\\">Caracter\\u00edsticas generales<\\\/span>\\n          <h2>Funcionalidad robusta para operaci\\u00f3n radiol\\u00f3gica.<\\\/h2>\\n        <\\\/div>\\n\\n        <p>\\n          El sistema est\\u00e1 pensado para almacenamiento, digitalizaci\\u00f3n, distribuci\\u00f3n intra y extra-sede, visualizaci\\u00f3n remota y soporte permanente.\\n        <\\\/p>\\n      <\\\/div>\\n\\n      <div class=\\\"rtp-features-grid\\\">\\n        <article class=\\\"rtp-feature\\\">\\n          <div class=\\\"rtp-icon\\\">01<\\\/div>\\n          <h3>Almacenamiento<\\\/h3>\\n          <p>Almacenamiento ilimitado de im\\u00e1genes radiol\\u00f3gicas de cualquier modalidad diagn\\u00f3stica.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rtp-feature\\\">\\n          <div class=\\\"rtp-icon\\\">02<\\\/div>\\n          <h3>Distribuci\\u00f3n<\\\/h3>\\n          <p>Digitalizaci\\u00f3n y distribuci\\u00f3n de estudios dentro y fuera de la sede m\\u00e9dica.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rtp-feature\\\">\\n          <div class=\\\"rtp-icon\\\">03<\\\/div>\\n          <h3>Versatilidad<\\\/h3>\\n          <p>Adaptaci\\u00f3n al flujo de trabajo de cada unidad mediante una base web-server flexible.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rtp-feature\\\">\\n          <div class=\\\"rtp-icon\\\">04<\\\/div>\\n          <h3>Visualizaci\\u00f3n remota<\\\/h3>\\n          <p>Acceso para m\\u00e9dicos tratantes a distancia desde diferentes plataformas.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rtp-feature\\\">\\n          <div class=\\\"rtp-icon\\\">05<\\\/div>\\n          <h3>Asistencia<\\\/h3>\\n          <p>Soporte, asistencia y mantenimiento las 24 horas, los 7 d\\u00edas de la semana.<\\\/p>\\n        <\\\/article>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section id=\\\"innovacion-pacs\\\" class=\\\"rtp-section\\\">\\n    <div class=\\\"rtp-wrap\\\">\\n      <div class=\\\"rtp-head\\\">\\n        <div>\\n          <span class=\\\"rtp-eyebrow\\\">Innovaci\\u00f3n y vanguardia<\\\/span>\\n          <h2>Herramientas clave para m\\u00e9dicos y pacientes.<\\\/h2>\\n        <\\\/div>\\n\\n        <p>\\n          Comparte estudios de manera r\\u00e1pida con pacientes y m\\u00e9dicos tratantes. Compatible con cualquier dispositivo y dise\\u00f1ado para mejorar tiempos de entrega.\\n        <\\\/p>\\n      <\\\/div>\\n\\n      <div class=\\\"rtp-tabs-shell\\\">\\n        <div class=\\\"rtp-tabs-nav\\\">\\n          <button class=\\\"rtp-tab-btn active\\\" type=\\\"button\\\" data-tab=\\\"visualizador\\\">\\n            <strong>Visualizaci\\u00f3n<\\\/strong>\\n            <span>Web y monitores de grado m\\u00e9dico.<\\\/span>\\n          <\\\/button>\\n\\n          <button class=\\\"rtp-tab-btn\\\" type=\\\"button\\\" data-tab=\\\"control\\\">\\n            <strong>Control de tiempos<\\\/strong>\\n            <span>Sem\\u00e1foro para entrega de reportes.<\\\/span>\\n          <\\\/button>\\n\\n          <button class=\\\"rtp-tab-btn\\\" type=\\\"button\\\" data-tab=\\\"envio\\\">\\n            <strong>Entrega digital<\\\/strong>\\n            <span>Correo, WhatsApp y acceso remoto.<\\\/span>\\n          <\\\/button>\\n\\n          <button class=\\\"rtp-tab-btn\\\" type=\\\"button\\\" data-tab=\\\"usuarios\\\">\\n            <strong>Usuarios y soporte<\\\/strong>\\n            <span>Concurrencia, almacenamiento y soporte 365.<\\\/span>\\n          <\\\/button>\\n        <\\\/div>\\n\\n        <article class=\\\"rtp-tab-panel active\\\" data-panel=\\\"visualizador\\\">\\n          <div class=\\\"rtp-tab-media\\\">\\n            <img src=\\\"https:\\\/\\\/raditech.mx\\\/wp-content\\\/uploads\\\/2024\\\/11\\\/pacs-estudios_iavbqq.png\\\" alt=\\\"Visualizador avanzado PACS Raditech\\\">\\n          <\\\/div>\\n\\n          <div class=\\\"rtp-tab-content\\\">\\n            <h3>Visualizador avanzado<\\\/h3>\\n\\n            <p>\\n              Visualizador web avanzado y compatibilidad con <a style=\\\"color: var(--rt-orange-2);\\\" href=\\\"https:\\\/\\\/raditech.mx\\\/monitores-medicos-radiologia\\\/\\\">monitores de grado m\\u00e9dico<\\\/a> para fortalecer la interpretaci\\u00f3n radiol\\u00f3gica.\\n            <\\\/p>\\n\\n            <ul class=\\\"rtp-checks\\\">\\n              <li>Visualizador avanzado web.<\\\/li>\\n              <li>Visualizador para monitores de grado m\\u00e9dico.<\\\/li>\\n              <li>Acceso desde diferentes dispositivos.<\\\/li>\\n              <li>Flujo cl\\u00ednico m\\u00e1s \\u00e1gil.<\\\/li>\\n            <\\\/ul>\\n          <\\\/div>\\n        <\\\/article>\\n\\n        <article class=\\\"rtp-tab-panel\\\" data-panel=\\\"control\\\">\\n          <div class=\\\"rtp-tab-media\\\">\\n            <img src=\\\"https:\\\/\\\/raditech.mx\\\/wp-content\\\/uploads\\\/2024\\\/11\\\/15_xovsdg-2.png\\\" alt=\\\"Control de estudios PACS RIS\\\">\\n          <\\\/div>\\n\\n          <div class=\\\"rtp-tab-content\\\">\\n            <h3>Control operativo<\\\/h3>\\n\\n            <p>\\n              Sem\\u00e1foro para control de tiempos de entrega de reportes, \\u00fatil para mejorar trazabilidad, seguimiento y respuesta del servicio.\\n            <\\\/p>\\n\\n            <ul class=\\\"rtp-checks\\\">\\n              <li>Control de tiempos de reportes.<\\\/li>\\n              <li>Mayor trazabilidad operativa.<\\\/li>\\n              <li>Gesti\\u00f3n del flujo radiol\\u00f3gico.<\\\/li>\\n              <li>Mejor seguimiento del estudio.<\\\/li>\\n            <\\\/ul>\\n          <\\\/div>\\n        <\\\/article>\\n\\n        <article class=\\\"rtp-tab-panel\\\" data-panel=\\\"envio\\\">\\n          <div class=\\\"rtp-tab-media\\\">\\n            <img src=\\\"https:\\\/\\\/raditech.mx\\\/wp-content\\\/uploads\\\/2024\\\/11\\\/pacs-raditech-interfaz.svg\\\" alt=\\\"Entrega digital de estudios m\\u00e9dicos\\\">\\n          <\\\/div>\\n\\n          <div class=\\\"rtp-tab-content\\\">\\n            <h3>Entrega digital<\\\/h3>\\n\\n            <p>\\n              Env\\u00edo de estudios por correo y WhatsApp mediante <a style=\\\"color: var(--rt-orange-2);\\\" href=\\\"https:\\\/\\\/raditech.mx\\\/portal-x-card\\\/\\\">X-Card digital<\\\/a>, adem\\u00e1s de notificaci\\u00f3n de emergencia al m\\u00e9dico tratante.\\n            <\\\/p>\\n\\n            <ul class=\\\"rtp-checks\\\">\\n              <li>Env\\u00edo de estudios por correo.<\\\/li>\\n              <li>Env\\u00edo por WhatsApp.<\\\/li>\\n              <li>Notificaci\\u00f3n de emergencia.<\\\/li>\\n              <li>Compartir con pacientes y m\\u00e9dicos.<\\\/li>\\n            <\\\/ul>\\n          <\\\/div>\\n        <\\\/article>\\n\\n        <article class=\\\"rtp-tab-panel\\\" data-panel=\\\"usuarios\\\">\\n          <div class=\\\"rtp-tab-media\\\">\\n            <img src=\\\"https:\\\/\\\/raditech.mx\\\/wp-content\\\/uploads\\\/2024\\\/11\\\/15_xovsdg-2.png\\\" alt=\\\"Usuarios concurrentes PACS RIS\\\">\\n          <\\\/div>\\n\\n          <div class=\\\"rtp-tab-content\\\">\\n            <h3>Usuarios y soporte<\\\/h3>\\n\\n            <p>\\n              Usuarios ilimitados concurrentes, almacenamiento ilimitado y soporte remoto los 365 d\\u00edas del a\\u00f1o, las 24 horas del d\\u00eda.\\n            <\\\/p>\\n\\n            <ul class=\\\"rtp-checks\\\">\\n              <li>Usuarios ilimitados concurrentes.<\\\/li>\\n              <li>Almacenamiento ilimitado.<\\\/li>\\n              <li>Soporte remoto 365 d\\u00edas.<\\\/li>\\n              <li>Asistencia 24 horas.<\\\/li>\\n            <\\\/ul>\\n          <\\\/div>\\n        <\\\/article>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section id=\\\"beneficios-pacs\\\" class=\\\"rtp-section soft\\\">\\n    <div class=\\\"rtp-wrap\\\">\\n      <div class=\\\"rtp-head\\\">\\n        <div>\\n          <span class=\\\"rtp-eyebrow\\\">Beneficios<\\\/span>\\n          <h2>Valor para cada perfil del servicio.<\\\/h2>\\n        <\\\/div>\\n\\n        <p>\\n          PACS-RIS facilita el trabajo del m\\u00e9dico radi\\u00f3logo, mejora la entrega de informaci\\u00f3n al paciente y permite mayor control administrativo y operativo.\\n        <\\\/p>\\n      <\\\/div>\\n\\n      <div class=\\\"rtp-audience-grid\\\">\\n        <article class=\\\"rtp-audience\\\">\\n          <div class=\\\"rtp-icon\\\">RX<\\\/div>\\n          <h3>M\\u00e9dico radi\\u00f3logo<\\\/h3>\\n          <p>Interpreta estudios donde quiera que te encuentres, con acceso remoto y herramientas de visualizaci\\u00f3n.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rtp-audience\\\">\\n          <div class=\\\"rtp-icon\\\">PA<\\\/div>\\n          <h3>Paciente<\\\/h3>\\n          <p>Cuenta con informaci\\u00f3n en tiempo para continuar su atenci\\u00f3n m\\u00e9dica de forma m\\u00e1s eficiente.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rtp-audience\\\">\\n          <div class=\\\"rtp-icon\\\">JA<\\\/div>\\n          <h3>Jefe del \\u00e1rea<\\\/h3>\\n          <p>Control estad\\u00edstico, seguimiento del flujo y entrega oportuna de estudios.<\\\/p>\\n        <\\\/article>\\n\\n        <article class=\\\"rtp-audience\\\">\\n          <div class=\\\"rtp-icon\\\">TI<\\\/div>\\n          <h3>Biom\\u00e9dica y sistemas<\\\/h3>\\n          <p>Soporte inmediato 24\\\/7 para mantener continuidad operativa.<\\\/p>\\n        <\\\/article>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section id=\\\"estudio-pacs\\\" class=\\\"rtp-section\\\">\\n    <div class=\\\"rtp-wrap\\\">\\n      <div class=\\\"rtp-study\\\">\\n        <div class=\\\"rtp-media-card\\\">\\n          <img src=\\\"https:\\\/\\\/raditech.mx\\\/wp-content\\\/uploads\\\/2024\\\/11\\\/pacs-estudios_iavbqq.png\\\" alt=\\\"Estudios m\\u00e9dicos en PACS Raditech\\\">\\n        <\\\/div>\\n\\n        <div class=\\\"rtp-study-card\\\">\\n          <span class=\\\"rtp-eyebrow\\\">Estudio digital<\\\/span>\\n\\n          <h2>Del estudio al m\\u00e9dico tratante, sin fricci\\u00f3n.<\\\/h2>\\n\\n          <p>\\n            Raditech PACS-RIS permite visualizar, distribuir y compartir estudios con pacientes y m\\u00e9dicos tratantes, integrando herramientas para control de reportes, usuarios concurrentes y soporte remoto continuo.\\n          <\\\/p>\\n\\n          <ul class=\\\"rtp-checks\\\">\\n            <li>Visualizador avanzado web.<\\\/li>\\n            <li>Sem\\u00e1foro de tiempos de entrega.<\\\/li>\\n            <li>Env\\u00edo por correo y WhatsApp.<\\\/li>\\n            <li>Soporte remoto 24\\\/7.<\\\/li>\\n          <\\\/ul>\\n\\n          <div class=\\\"rtp-actions\\\">\\n            <a class=\\\"rtp-btn primary\\\" href=\\\"https:\\\/\\\/wa.me\\\/5215534449236\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Me interesa<\\\/a>\\n          <\\\/div>\\n        <\\\/div>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section id=\\\"cotizar-pacs\\\" class=\\\"rtp-cost\\\">\\n    <div class=\\\"rtp-wrap\\\">\\n      <div class=\\\"rtp-cost-box\\\">\\n        <div>\\n          <h2>Sin costo de instalaci\\u00f3n, capacitaci\\u00f3n y mantenimiento.<\\\/h2>\\n          <p>Solicita informaci\\u00f3n para implementar PACS-RIS Raditech en tu unidad m\\u00e9dica, cl\\u00ednica u hospital.<\\\/p>\\n        <\\\/div>\\n\\n        <div class=\\\"rtp-actions\\\">\\n          <a class=\\\"rtp-btn primary\\\" href=\\\"https:\\\/\\\/wa.me\\\/5215534449236\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">WhatsApp<\\\/a>\\n          <a class=\\\"rtp-btn secondary\\\" href=\\\"https:\\\/\\\/wa.me\\\/5215534449236?text=Hola%2C%20quiero%20cotizar%20PACS-RIS%20Raditech\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Cotizar<\\\/a>\\n        <\\\/div>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <section class=\\\"rtp-related\\\">\\n    <div class=\\\"rtp-wrap\\\">\\n      <p class=\\\"rtp-eyebrow\\\" style=\\\"margin-bottom: 24px;\\\">Ecosistema Raditech<\\\/p>\\n\\n      <h2 style=\\\"font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 900; color: #fff; margin-bottom: 40px; line-height: 1.1;\\\">\\n        Servicios <span style=\\\"color: var(--rt-orange);\\\">relacionados<\\\/span>\\n      <\\\/h2>\\n\\n      <div class=\\\"rtp-related-grid\\\">\\n        <a class=\\\"rtp-related-card\\\" href=\\\"https:\\\/\\\/raditech.mx\\\/teleradiologia\\\/\\\">\\n          <div class=\\\"rtp-related-icon\\\">\\ud83d\\udce1<\\\/div>\\n          <h3>Teleradiolog\\u00eda 24\\\/7<\\\/h3>\\n          <p>Interpretaci\\u00f3n remota DICOM con radi\\u00f3logos certificados. Urgencias en menos de 60 minutos.<\\\/p>\\n        <\\\/a>\\n\\n        <a class=\\\"rtp-related-card\\\" href=\\\"https:\\\/\\\/raditech.mx\\\/portal-x-card\\\/\\\">\\n          <div class=\\\"rtp-related-icon\\\">\\ud83e\\udeaa<\\\/div>\\n          <h3>Portal X-Card<\\\/h3>\\n          <p>Entrega digital de estudios al paciente v\\u00eda c\\u00f3digo QR. Sin placas ni CDs.<\\\/p>\\n        <\\\/a>\\n\\n        <a class=\\\"rtp-related-card\\\" href=\\\"https:\\\/\\\/raditech.mx\\\/teleradiologia-de-alta-especialidad\\\/\\\">\\n          <div class=\\\"rtp-related-icon\\\">\\ud83e\\udde0<\\\/div>\\n          <h3>Alta Especialidad<\\\/h3>\\n          <p>Subespecialistas en neuroradiolog\\u00eda, cardiovascular y musculoesquel\\u00e9tica disponibles 24\\\/7.<\\\/p>\\n        <\\\/a>\\n      <\\\/div>\\n    <\\\/div>\\n  <\\\/section>\\n\\n  <script>\\n    (function () {\\n      const root = document.querySelector(\\\".rt-pacs-page\\\");\\n      if (!root) return;\\n\\n      const buttons = root.querySelectorAll(\\\".rtp-tab-btn\\\");\\n      const panels = root.querySelectorAll(\\\".rtp-tab-panel\\\");\\n\\n      buttons.forEach(function (button) {\\n        button.addEventListener(\\\"click\\\", function () {\\n          const tab = button.getAttribute(\\\"data-tab\\\");\\n\\n          buttons.forEach(function (btn) {\\n            btn.classList.remove(\\\"active\\\");\\n          });\\n\\n          panels.forEach(function (panel) {\\n            panel.classList.remove(\\\"active\\\");\\n          });\\n\\n          button.classList.add(\\\"active\\\");\\n\\n          const activePanel = root.querySelector('[data-panel=\\\"' + tab + '\\\"]');\\n          if (activePanel) activePanel.classList.add(\\\"active\\\");\\n        });\\n      });\\n\\n      const animated = root.querySelectorAll(\\\".rtp-stat, .rtp-quick-box, .rtp-panel, .rtp-media-card, .rtp-feature, .rtp-tab-panel, .rtp-audience, .rtp-study-card, .rtp-cost-box, .rtp-related-card\\\");\\n\\n      if (!(\\\"IntersectionObserver\\\" in window)) {\\n        animated.forEach(function (item) {\\n          item.style.opacity = \\\"1\\\";\\n          item.style.transform = \\\"translateY(0)\\\";\\n        });\\n        return;\\n      }\\n\\n      animated.forEach(function (item) {\\n        item.style.opacity = \\\"0\\\";\\n        item.style.transform = \\\"translateY(18px)\\\";\\n        item.style.transition = \\\"opacity .55s ease, transform .55s ease\\\";\\n      });\\n\\n      const observer = new IntersectionObserver(function (entries) {\\n        entries.forEach(function (entry) {\\n          if (entry.isIntersecting) {\\n            entry.target.style.opacity = \\\"1\\\";\\n            entry.target.style.transform = \\\"translateY(0)\\\";\\n            observer.unobserve(entry.target);\\n          }\\n        });\\n      }, { threshold: 0.12 });\\n\\n      animated.forEach(function (item) {\\n        observer.observe(item);\\n      });\\n    })();\\n  <\\\/script>\\n\\n  <script type=\\\"application\\\/ld+json\\\">\\n  {\\n    \\\"@context\\\": \\\"https:\\\/\\\/schema.org\\\",\\n    \\\"@type\\\": \\\"FAQPage\\\",\\n    \\\"mainEntity\\\": [\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"\\u00bfQu\\u00e9 es un sistema PACS-RIS?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"PACS es un sistema para almacenar, recuperar y distribuir im\\u00e1genes m\\u00e9dicas DICOM. RIS gestiona el flujo de trabajo radiol\\u00f3gico. Juntos forman la columna vertebral digital de un \\u00e1rea de imagen.\\\"\\n        }\\n      },\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"\\u00bfVIRA PACS-RIS funciona sin instalaciones en el hospital?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"S\\u00ed. VIRA PACS-RIS de Raditech es 100% web, sin necesidad de instalar software. Solo requiere internet y navegador.\\\"\\n        }\\n      },\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"\\u00bfEs compatible con cualquier equipo de imagen?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"S\\u00ed. Compatible con cualquier modalidad que genere im\\u00e1genes DICOM: rayos X, TAC, resonancia magn\\u00e9tica, ultrasonido, mamograf\\u00eda y medicina nuclear.\\\"\\n        }\\n      },\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"\\u00bfCu\\u00e1nto cuesta implementar PACS-RIS?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"Sin costo de instalaci\\u00f3n, capacitaci\\u00f3n ni mantenimiento. El costo depende del volumen de estudios y sedes.\\\"\\n        }\\n      },\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"\\u00bfSe integra con teleradiolog\\u00eda?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"S\\u00ed. VIRA PACS-RIS trabaja junto con el servicio de teleradiolog\\u00eda 24\\\/7 de Raditech, formando un ecosistema completo de imagen m\\u00e9dica.\\\"\\n        }\\n      },\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"\\u00bfTiene soporte t\\u00e9cnico disponible?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"S\\u00ed. Soporte remoto 24\\\/7 los 365 d\\u00edas del a\\u00f1o, incluyendo noches, fines de semana y festivos.\\\"\\n        }\\n      }\\n    ]\\n  }\\n  <\\\/script>\\n<\\\/section>\\n```\\n\"},\"elements\":[],\"widgetType\":\"text-editor\"}],\"isInner\":false}]"
