box-shadow:0 0 14px rgba(0,229,196,.55);\n\n    }\n\n\n\n    .pys-title{\n\n      margin:0;font-family:\"Optima\",\"Optima LT Std\",\"Candara\",\"Segoe UI\",Arial,sans-serif;\n\n      font-size:clamp(3.2rem,7vw,7rem);line-height:.9;font-weight:400;\n\n      letter-spacing:-.06em;color:#fff;max-width:780px;\n\n    }\n\n    .pys-title span{\n\n      background:linear-gradient(135deg,#00e5c4,#f7007a);\n\n      -webkit-background-clip:text;-webkit-text-fill-color:transparent;\n\n    }\n\n    .pys-copy,.pys-section-copy{\n\n      color:#cfd5d2;line-height:1.9;font-size:1.02rem;\n\n    }\n\n    .pys-copy{margin:30px 0 0;max-width:700px}\n\n\n\n    .pys-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px}\n\n    .pys-btn{\n\n      min-height:54px;padding:16px 28px;border-radius:999px;text-decoration:none!important;\n\n      display:inline-flex;align-items:center;justify-content:center;text-transform:uppercase;\n\n      letter-spacing:.11em;font-size:.75rem;font-weight:900;transition:.28s ease;\n\n    }\n\n    .pys-btn-primary{background:#00e5c4;color:#111!important;box-shadow:0 18px 44px rgba(0,229,196,.24)}\n\n    .pys-btn-secondary{border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.06);color:#fff!important}\n\n    .pys-btn:hover{transform:translateY(-4px)}\n\n\n\n    .pys-visual{\n\n      position:relative;min-height:680px;border-radius:38px;overflow:hidden;\n\n      background:\n\n        radial-gradient(circle at top left,rgba(0,229,196,.18),transparent 30%),\n\n        radial-gradient(circle at bottom right,rgba(247,0,122,.18),transparent 28%),\n\n        linear-gradient(145deg,#131517,#1b1d20);\n\n      border:1px solid rgba(255,255,255,.1);box-shadow:0 34px 70px rgba(0,0,0,.34);\n\n    }\n\n    .pys-visual:before{\n\n      content:\"\";position:absolute;inset:18px;border-radius:28px;border:1px solid rgba(255,255,255,.08);\n\n      background:\n\n        linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),\n\n        linear-gradient(9