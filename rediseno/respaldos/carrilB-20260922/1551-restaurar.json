08),rgba(255,255,255,.03));\n\n      border:1px solid rgba(255,255,255,.12);box-shadow:0 22px 48px rgba(0,0,0,.24);\n\n    }\n\n    .pys-card h3{margin:0 0 16px;color:#fff;font-size:1.3rem}\n\n    .pys-card p{margin:0;color:#d4d8d6;line-height:1.8;font-size:.96rem}\n\n    .pys-number{\n\n      width:54px;height:54px;border-radius:18px;display:flex;align-items:center;justify-content:center;\n\n      background:linear-gradient(135deg,#00e5c4,#f7007a);color:#111;font-weight:900;margin-bottom:22px;\n\n    }\n\n\n\n    .pys-editorial{\n\n      border-radius:38px;padding:70px;background:\n\n        radial-gradient(circle at top left,rgba(0,229,196,.16),transparent 28%),\n\n        radial-gradient(circle at bottom right,rgba(247,0,122,.14),transparent 26%),\n\n        linear-gradient(135deg,#141516,#1b1117);\n\n      border:1px solid rgba(255,255,255,.12);box-shadow:0 28px 70px rgba(0,0,0,.3);\n\n    }\n\n    .pys-editorial h2{\n\n      margin:0;font-family:\"Optima\",\"Optima LT Std\",\"Candara\",\"Segoe UI\",Arial,sans-serif;\n\n      font-size:clamp(2.3rem,5vw,5rem);line-height:.96;font-weight:400;letter-spacing:-.05em;color:#fff;\n\n    }\n\n    .pys-editorial p{max-width:780px;margin:26px 0 0;color:#d4d9d7;line-height:1.9}\n\n\n\n    @media(max-width:1100px){\n\n      .pys-hero-grid,.pys-grid-cards{grid-template-columns:1fr}\n\n      .pys-visual{min-height:620px}\n\n    }\n\n\n\n    @media(max-width:640px){\n\n      .pys-wrap{width:min(100% - 28px,1180px)}\n\n      .pys-hero{padding:70px 0 50px}\n\n      .pys-title{font-size:clamp(2.4rem,13vw,4.3rem);line-height:.95}\n\n      .pys-actions{flex-direction:column}\n\n      .pys-btn{width:100%}\n\n      .pys-section{padding:58px 0}\n\n      .pys-card,.pys-editorial{padding:30px 24px}\n\n      .pys-visual{min-height:520px}\n\n      .pys-floating{position:relative;width:calc(100% - 36px);left:auto;top:auto;margin:18px}\n\n      .pys-pill{left:18px;right:18px;text-align:center}\n\n      .pys-watermark{font-size:4rem}\n\n    }\n\n  </style>\n\n\n\n  <div class=\"pys-bg-grid\"></div>\n\n\n\n  <section class=\"pys-hero\">\n\n    <div class=\"pys-wrap\">\n\n      <div class=\"pys-hero-grid\">\n\n        <div>\n\n          <div class=\"pys-badge\">Péptidos y Suplementos MX</div>\n\n\n\n          <h1 class=\"pys-title\">\n\n            Péptidos en México para <span>investigación, metabolismo y recuperación</span>\n\n          </h1>\n\n\n\n          <p class=\"pys-copy\">\n\n            Explora una selección especializada de péptidos en México, con enfoque en investigación, pureza, disponibilidad, bienestar avanzado, recuperación física y optimización metabólica.\n\n          </p>\n\n\n\n          <div class=\"pys-actions\">\n\n            <a class=\"pys-btn pys-btn-primary\" href=\"#catalogo-peptidos\">Ver péptidos</a>\n\n            <a class=\"pys-btn pys-btn-secondary\" href=\"https://wa.me/5215534449236?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20p%C3%A9ptidos%20en%20M%C3%A9xico.\">Solicitar información</a>\n\n          </div>\n\n        </div>\n\n\n\n        <div class=\"pys-visual\">\n\n          <div class=\"pys-watermark\">P&S</div>\n\n\n\n          <div class=\"pys-floating\">\n\n            <h3>Péptidos de investigación</h3>\n\n            <p>Compuestos seleccionados para investigación, metabolismo, recuperación física y bienestar avanzado.</p>\n\n          </div>\n\n\n\n          <img class=\"pys-featured-image\" src=\"http://peptidosysuplementos.mx/wp-content/uploads/2026/05/peptidos.png\" alt=\"Péptidos en México\">\n\n\n\n          <div class=\"pys-pill\">Catálogo especializado</div>\n\n        </div>\n\n      </div>\n\n    </div>\n\n  </section>\n\n\n\n  <section class=\"pys-section\">\n\n    <div class=\"pys-wrap\">\n\n      <div class=\"pys-head\">\n\n        <div class=\"pys-tag\">Péptidos</div>\n\n        <h2 class=\"pys-section-title\">Péptidos para investigación y wellness avanzado</h2>\n\n        <p class=\"pys-section-copy\">\n\n          Los péptidos son cadenas de aminoácidos estudiadas por su relación con procesos biológicos como metabolismo, recuperación física, reparación tisular, señalización celular y composición corporal.\n\n        </p>\n\n      </div>\n\n\n\n      <div class=\"pys-grid-cards\">\n\n        <article class=\"pys-card\">\n\n          <div class=\"pys-number\">01</div>\n\n          <h3>Metabolismo</h3>\n\n          <p>Péptidos vinculados a líneas de investigación sobre metabolismo, composición corporal y bienestar avanzado.</p>\n\n        </article>\n\n\n\n        <article class=\"pys-card\">\n\n          <div class=\"pys-number\">02</div>\n\n          <h3>Recuperación</h3>\n\n          <p>Compuestos relacionados con investigación sobre recuperación física, tejidos y rendimiento funcional.</p>\n\n        </article>\n\n\n\n        <article class=\"pys-card\">\n\n          <div class=\"pys-number\">03</div>\n\n          <h3>Biohacking</h3>\n\n          <p>Productos integrados al ecosistema de investigación, suplementación avanzada y optimización humana.</p>\n\n        </article>\n\n      </div>\n\n    </div>\n\n  </section>\n\n\n\n  <section class=\"pys-section\" id=\"catalogo-peptidos\">\n\n    <div class=\"pys-wrap\">\n\n      <div class=\"pys-head\">\n\n        <div class=\"pys-tag\">Catálogo</div>\n\n        <h2 class=\"pys-section-title\">Péptidos disponibles</h2>\n\n        <p class=\"pys-section-copy\">\n\n          Catálogo completo de la línea de péptidos de Péptidos y Suplementos MX (18 productos).\n\n        </p>\n\n      </div>\n\n\n\n      [pys_catalogo tipo=\"peptidos\"]\n\n    </div>\n\n  </section><section class=\"pys-section\">\n\n    <div class=\"pys-wrap\">\n\n      <div class=\"pys-editorial\">\n\n        <div class=\"pys-tag\">Información clara</div>\n\n\n\n        <h2>Péptidos en México con enfoque responsable</h2>\n\n\n\n        <p>\n\n          Consulta productos, presentaciones y disponibilidad dentro del catálogo de Péptidos y Suplementos MX. Esta página está orientada a información comercial y descriptiva sobre péptidos.\n\n        </p>\n\n\n\n        <div class=\"pys-actions\">\n\n          <a class=\"pys-btn pys-btn-primary\" href=\"https://peptidosysuplementos.mx/comprar-peptidos-en-mexico/\">Explorar catálogo</a>\n\n          <a class=\"pys-btn pys-btn-secondary\" href=\"https://wa.me/5215534449236?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20p%C3%A9ptidos%20y%20suplementos.\">WhatsApp</a>\n\n        </div>\n\n      </div>\n\n    </div>\n\n  </section>\n\n</section>\n<h2>Guías por necesidad</h2>\n<ul>\n\n<li><a href=\"https://peptidosysuplementos.mx/peptidos-inyectables/\">Péptidos inyectables</a></li>\n<li><a href=\"https://peptidosysuplementos.mx/peptidos-para-masa-muscular/\">Péptidos para masa muscular</a></li>\n</ul>\n<p>El catálogo de <strong>péptidos México</strong> de PyS reúne compuestos de investigación con pureza ≥99% verificada por HPLC y certificado de análisis por lote. Cada ficha indica gramaje, precio y disponibilidad real.</p><h2>Cómo elegir entre los péptidos México disponibles</h2>\n<p>Al comparar <strong>péptidos México</strong> conviene revisar tres cosas antes del precio: que exista certificado de análisis por lote, que el gramaje esté declarado con claridad y que el proveedor indique cómo reconstituir el vial. Un catálogo de <strong>péptidos México</strong> sin esos datos obliga a confiar a ciegas.</p>"},"elements":[],"widgetType":"html"}],"isInner":false}]